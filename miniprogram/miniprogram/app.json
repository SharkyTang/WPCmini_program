{
  "pages": [
    "pages/index/index",
    "pages/category/index",
    "pages/profile/index",
    "pages/detail/index"
  ],
  "subpackages": [
    {
      "name": "account-profile-edit",
      "root": "pages/profile/edit",
      "pages": ["index"]
    },
    {
      "name": "account-favorites",
      "root": "pages/favorites",
      "pages": ["index"]
    },
    {
      "name": "account-history",
      "root": "pages/history",
      "pages": ["index"]
    },
    {
      "name": "account-notifications",
      "root": "pages/notifications",
      "pages": ["index"]
    },
    {
      "name": "account-feedback",
      "root": "pages/feedback",
      "pages": ["index"]
    },
    {
      "name": "account-contact",
      "root": "pages/contact",
      "pages": ["index"]
    },
    {
      "name": "account-privacy",
      "root": "pages/privacy",
      "pages": ["index"]
    },
    {
      "name": "admin-contact",
      "root": "pages/contact-admin",
      "pages": ["edit"]
    },
    {
      "name": "account-inquiry",
      "root": "pages/inquiry",
      "pages": ["index"]
    },
    {
      "name": "account-my-inquiries",
      "root": "pages/my-inquiries",
      "pages": ["index", "detail"]
    },
    {
      "name": "account-notification-cases",
      "root": "pages/notification-cases",
      "pages": ["index"]
    },
    {
      "name": "admin-case",
      "root": "pages/case-admin",
      "pages": ["index", "edit"]
    },
    {
      "name": "admin-inquiry",
      "root": "pages/inquiry-admin",
      "pages": ["index", "detail"]
    },
    {
      "name": "admin-notification",
      "root": "pages/notification-admin",
      "pages": ["index", "edit"]
    }
  ],
  "preloadRule": {
    "pages/profile/index": {
      "network": "wifi",
      "packages": [
        "account-profile-edit",
        "account-favorites",
        "account-history",
        "account-notifications",
        "account-feedback",
        "account-inquiry",
        "account-my-inquiries"
      ]
    },
    "pages/notifications/index": {
      "network": "wifi",
      "packages": ["account-notification-cases"]
    }
  },
  "window": {
    "backgroundColor": "#F7F3EC",
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#F7F3EC",
    "navigationBarTitleText": "酒包装灵感库",
    "navigationBarTextStyle": "black"
  },
  "useExtendedLib": {
    "weui": true
  },
  "tabBar": {
    "color": "#8c8176",
    "selectedColor": "#241d16",
    "backgroundColor": "#fffdf9",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "images/icons/home.png",
        "selectedIconPath": "images/icons/home-active.png"
      },
      {
        "pagePath": "pages/category/index",
        "text": "分类",
        "iconPath": "images/icons/goods.png",
        "selectedIconPath": "images/icons/goods-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "个人中心",
        "iconPath": "images/icons/usercenter.png",
        "selectedIconPath": "images/icons/usercenter-active.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents"
}
