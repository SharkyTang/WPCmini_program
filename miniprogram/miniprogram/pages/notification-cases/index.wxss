page {
  min-height: 100%;
  background: var(--brand-bg);
  color: var(--brand-ink);
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 28rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.page-title {
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 900;
}

.page-subtitle {
  margin-top: 9rpx;
  color: #766b60;
  font-size: 23rpx;
  line-height: 1.5;
}

.manage-button {
  flex: 0 0 auto;
  min-width: 92rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 28rpx;
  background: #fffdf9;
  color: #8c6a3f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.unavailable-tip,
.manage-toolbar {
  margin-bottom: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: #f3e8d7;
  color: #80531f;
  font-size: 22rpx;
  line-height: 1.45;
}

.manage-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.manage-action {
  color: #285f42;
  font-weight: 800;
}

.state-shell {
  padding: 18rpx 24rpx 38rpx;
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
  text-align: center;
}

.state-error {
  background: var(--brand-red-soft);
}

.state-button {
  width: 260rpx;
  height: 68rpx;
  margin: 4rpx auto 0;
  border-radius: 8rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.cases-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx;
}

.cases-grid-selecting {
  padding-bottom: 104rpx;
}

.case-card {
  min-width: 0;
  position: relative;
  padding: 10rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
  box-sizing: border-box;
}

.case-card-selected {
  border-color: var(--brand-gold);
  background: var(--brand-gold-soft);
}

.select-mark {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 2;
}

.select-dot {
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid #241d16;
  border-radius: 50%;
  background: rgba(255, 253, 249, 0.94);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.case-card-selected .select-dot {
  border-color: var(--brand-green);
  background: var(--brand-green);
}

.case-image,
.case-placeholder {
  width: 100%;
  aspect-ratio: 1.22;
  border-radius: 6rpx;
  background: #f5e2ae;
}

.case-placeholder {
  color: #9d8d78;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.case-title {
  margin-top: 13rpx;
  color: #241d16;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-tags {
  min-height: 30rpx;
  margin-top: 7rpx;
  color: #8c6a3f;
  font-size: 22rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.load-more {
  height: 70rpx;
  margin-top: 26rpx;
  color: #80531f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #eadcc8;
  background: rgba(245, 239, 228, 0.98);
  z-index: 10;
}

.complete-button {
  height: 76rpx;
  border-radius: 8rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}
