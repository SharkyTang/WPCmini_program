<view class="page">
  <mp-toptips
    msg="{{topTips.message}}"
    type="{{topTips.type}}"
    show="{{topTips.show}}"
    bindhide="hideTopTips"
  />

  <view class="hero">
    <view class="page-title">{{isEdit ? '编辑案例' : '新增案例'}}</view>
    <view class="page-subtitle">{{isEdit ? '修改标题、标签、封面和显示状态' : '先创建隐藏案例，确认后再打开显示'}}</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">正在读取案例...</view>

  <view wx:elif="{{errorMessage}}" class="state-card">
    <view class="state-title">读取失败</view>
    <view class="state-desc">{{errorMessage}}</view>
  </view>

  <view wx:else class="form-card">
    <view class="form-section-title">基础信息</view>
    <view class="field">
      <view class="field-label">案例图片 *</view>
      <view class="gallery-upload-wrap">
        <view class="gallery-grid">
          <view wx:for="{{galleryPreviewUrls}}" wx:key="*this" class="gallery-item">
            <image class="gallery-preview" src="{{item}}" mode="aspectFill" />
            <view wx:if="{{index === 0}}" class="gallery-cover-badge">封面</view>
            <view class="gallery-actions">
              <view wx:if="{{index > 0}}" class="gallery-action" data-index="{{index}}" data-direction="left" bindtap="moveGalleryImage">←</view>
              <view wx:if="{{index < galleryPreviewUrls.length - 1}}" class="gallery-action" data-index="{{index}}" data-direction="right" bindtap="moveGalleryImage">→</view>
              <view class="gallery-action gallery-remove" data-index="{{index}}" bindtap="removeGalleryImage">×</view>
            </view>
          </view>
          <view wx:if="{{galleryPreviewUrls.length < galleryMax}}" class="cover-picker" bindtap="chooseGalleryImages">
            <view class="cover-plus">+</view>
            <view>添加图片</view>
            <view class="gallery-count">{{galleryPreviewUrls.length}} / {{galleryMax}}</view>
          </view>
        </view>
        <view wx:if="{{uploading}}" class="upload-mask">上传中...</view>
      </view>
      <button
        wx:if="{{imageProcessingFailed}}"
        class="image-retry-button"
        loading="{{uploading}}"
        disabled="{{uploading}}"
        bindtap="retryImageProcessing"
      >
        重试处理
      </button>
      <view class="field-hint">最多 {{galleryMax}} 张；第一张为封面，可通过箭头调整顺序。图片会上传到云存储。</view>
    </view>

    <block wx:if="{{isEdit}}">
      <view class="form-section-title">展示视频</view>
      <view class="video-upload-card">
        <view class="video-source-header">
          <view
            class="video-source-option {{videoSource === 'upload' ? 'video-source-option-active' : ''}} {{!videoUploadEnabled || saving ? 'video-source-option-disabled' : ''}}"
            data-source="upload"
            bindtap="onVideoSourceSelect"
          >
            上传 MP4
          </view>
          <view class="video-advanced-toggle {{saving ? 'video-source-option-disabled' : ''}}" bindtap="onVideoAdvancedToggle">
            高级设置 · HTTPS 外链 {{videoAdvancedOpen ? '收起' : '展开'}}
          </view>
        </view>

        <view wx:if="{{videoSource === 'upload'}}" class="video-upload-body">
          <view wx:if="{{!videoUploadEnabled}}" class="video-disabled-hint">云视频上传暂未开启；已有视频仍可预览或移除，也可以在高级设置中使用 HTTPS 外链。</view>
          <video
            wx:if="{{videoDraft.uploadPreviewUrl}}"
            class="video-admin-preview"
            src="{{videoDraft.uploadPreviewUrl}}"
            poster="{{videoDraft.uploadPosterPreviewUrl || coverImageUrl}}"
            controls="{{true}}"
            object-fit="cover"
            binderror="onVideoPreviewError"
          />
          <view wx:else class="video-empty-state">
            <view class="video-empty-title">还没有展示视频</view>
            <view class="field-hint">从手机相册选择 MP4，不开放现场拍摄。</view>
          </view>

          <view wx:if="{{videoDraft.uploadFileID}}" class="video-meta-row">
            <text>{{videoDraft.uploadDurationSeconds}} 秒</text>
            <text wx:if="{{videoFileSizeLabel}}">{{videoFileSizeLabel}}</text>
            <text>最高 1080p</text>
          </view>
          <view wx:if="{{videoUploading}}" class="video-progress-block">
            <view class="video-progress-track">
              <view class="video-progress-value" style="width: {{videoUploadProgress}}%;"></view>
            </view>
            <view class="field-hint">视频上传中 {{videoUploadProgress}}%</view>
          </view>
          <view wx:if="{{videoUploadError}}" class="video-error-text">{{videoUploadError}}</view>
          <view class="video-action-row">
            <button
              class="video-action-button video-action-primary"
              loading="{{videoUploading}}"
              disabled="{{saving || !videoUploadEnabled || videoUploading || posterUploading}}"
              bindtap="chooseCaseVideo"
            >
              {{videoDraft.uploadFileID ? '替换视频' : '从相册选择视频'}}
            </button>
            <button
              wx:if="{{videoUploadError}}"
              class="video-action-button"
              disabled="{{saving || videoUploading}}"
              bindtap="retryVideoUpload"
            >
              重试上传
            </button>
            <button
              wx:if="{{videoDraft.uploadFileID}}"
              class="video-action-button video-action-danger"
              disabled="{{saving || videoUploading || posterUploading}}"
              bindtap="removeCaseVideo"
            >
              移除视频
            </button>
          </view>
          <view class="field-hint">仅支持 MP4，最大 100MB、最长 120 秒、1080p；建议 H.264 + AAC。</view>

          <view wx:if="{{videoDraft.uploadFileID}}" class="video-poster-section">
            <view class="field-label">自定义视频封面（可选）</view>
            <image
              wx:if="{{videoDraft.uploadPosterPreviewUrl}}"
              class="video-poster-preview"
              src="{{videoDraft.uploadPosterPreviewUrl}}"
              mode="aspectFill"
            />
            <view wx:else class="field-hint">未上传时使用案例第一张图片。</view>
            <view wx:if="{{posterUploading}}" class="field-hint">封面上传中 {{posterUploadProgress}}%</view>
            <view wx:if="{{posterUploadError}}" class="video-error-text">{{posterUploadError}}</view>
            <view class="video-action-row">
              <button
                class="video-action-button"
                loading="{{posterUploading}}"
                disabled="{{saving || !videoUploadEnabled || videoUploading || posterUploading}}"
                bindtap="chooseVideoPoster"
              >
                {{videoDraft.uploadPosterFileID ? '替换封面' : '上传封面'}}
              </button>
              <button
                wx:if="{{posterUploadError}}"
                class="video-action-button"
                disabled="{{saving || !videoUploadEnabled || posterUploading}}"
                bindtap="retryVideoPosterUpload"
              >
                重试封面
              </button>
              <button
                wx:if="{{videoDraft.uploadPosterFileID}}"
                class="video-action-button video-action-danger"
                disabled="{{saving || posterUploading}}"
                bindtap="removeVideoPoster"
              >
                移除封面
              </button>
            </view>
            <view class="field-hint">支持 JPEG、PNG、WebP，最大 5MB。</view>
          </view>
        </view>

        <view wx:if="{{videoAdvancedOpen}}" class="video-external-panel">
          <view
            class="video-source-option {{videoSource === 'external' ? 'video-source-option-active' : ''}} {{saving ? 'video-source-option-disabled' : ''}}"
            data-source="external"
            bindtap="onVideoSourceSelect"
          >
            使用 HTTPS 外链
          </view>
          <block wx:if="{{videoSource === 'external'}}">
            <video
              wx:if="{{videoDraft.externalUrl}}"
              class="video-admin-preview video-external-preview"
              src="{{videoDraft.externalUrl}}"
              poster="{{videoDraft.externalPosterUrl || coverImageUrl}}"
              controls="{{true}}"
              object-fit="cover"
              binderror="onVideoPreviewError"
            />
            <view wx:if="{{videoUploadError}}" class="video-error-text">{{videoUploadError}}</view>
            <view class="field video-external-field">
              <view class="field-label">视频地址 *</view>
              <input
                class="text-input"
                type="text"
                disabled="{{saving}}"
                value="{{videoDraft.externalUrl}}"
                placeholder="https://example.com/video.mp4"
                bindinput="onExternalVideoUrlInput"
              />
            </view>
            <view class="field video-external-field">
              <view class="field-label">封面地址</view>
              <input
                class="text-input"
                type="text"
                disabled="{{saving}}"
                value="{{videoDraft.externalPosterUrl}}"
                placeholder="https://example.com/poster.jpg"
                bindinput="onExternalPosterUrlInput"
              />
            </view>
            <view class="field video-external-field">
              <view class="field-label">时长（秒）</view>
              <input
                class="text-input"
                type="number"
                disabled="{{saving}}"
                value="{{videoDraft.externalDurationSeconds}}"
                placeholder="可不填，最多 120"
                bindinput="onExternalDurationInput"
              />
            </view>
            <button
              wx:if="{{videoDraft.externalUrl}}"
              class="video-action-button video-action-danger"
              disabled="{{saving || videoUploading || posterUploading}}"
              bindtap="removeCaseVideo"
            >
              移除视频
            </button>
          </block>
        </view>

        <view wx:if="{{videoDirty}}" class="video-unsaved-hint">视频修改将在点击“保存修改”后生效。</view>
      </view>
    </block>

    <view class="field">
      <view class="field-label">标题 *</view>
      <input class="text-input" value="{{form.title}}" placeholder="例如：国风礼盒包装" bindinput="onTitleInput" />
    </view>

    <view class="field">
      <view class="field-label">案例编号</view>
      <input class="text-input" value="{{form.caseId}}" placeholder="可不填，系统自动生成" bindinput="onCaseIdInput" />
    </view>

    <view class="field">
      <view class="field-label">酒类</view>
      <view class="chip-row">
        <view class="chip chip-active">白酒</view>
      </view>
    </view>

    <view class="form-section-title">分类标签</view>
    <view class="field">
      <view class="field-label">包装内容 *</view>
      <view class="chip-grid">
        <view
          wx:for="{{optionViews.packageTypes}}"
          wx:key="value"
          class="chip {{item.selected ? 'chip-active' : ''}}"
          data-field="packageTypes"
          data-value="{{item.value}}"
          bindtap="toggleMulti"
        >
          {{item.label || item.value}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">风格</view>
      <view class="chip-grid">
        <view
          wx:for="{{optionViews.styles}}"
          wx:key="value"
          class="chip {{item.selected ? 'chip-active' : ''}}"
          data-field="styles"
          data-value="{{item.value}}"
          bindtap="toggleMulti"
        >
          {{item.label || item.value}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">价位感</view>
      <view class="chip-grid">
        <view
          wx:for="{{optionViews.priceLevel}}"
          wx:key="value"
          class="chip {{item.selected ? 'chip-active' : ''}}"
          data-field="priceLevel"
          data-value="{{item.value}}"
          bindtap="selectSingle"
        >
          {{item.label || item.value}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">使用场景</view>
      <view class="chip-grid">
        <view
          wx:for="{{optionViews.scenes}}"
          wx:key="value"
          class="chip {{item.selected ? 'chip-active' : ''}}"
          data-field="scenes"
          data-value="{{item.value}}"
          bindtap="toggleMulti"
        >
          {{item.label || item.value}}
        </view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">状态</view>
      <view class="chip-grid">
        <view
          wx:for="{{optionViews.statuses}}"
          wx:key="value"
          class="chip {{item.selected ? 'chip-active' : ''}}"
          data-field="statuses"
          data-value="{{item.value}}"
          bindtap="toggleMulti"
        >
          {{item.label || item.value}}
        </view>
      </view>
    </view>

    <view class="form-section-title">排序与备注</view>
    <view class="field">
      <view class="field-label">排序</view>
      <input class="text-input" type="number" value="{{form.sortOrder}}" placeholder="数字越小越靠前，可不填" bindinput="onSortOrderInput" />
    </view>

    <view class="field">
      <view class="field-label">备注</view>
      <textarea class="textarea-input" value="{{form.notes}}" maxlength="800" placeholder="可写材质、适合场景、内部说明" bindinput="onNotesInput" />
    </view>

    <view class="form-section-title">展示设置</view>
    <view class="visible-row">
      <view>
        <view class="field-label">前台显示</view>
        <view class="field-hint">新增默认隐藏，确认图片和标签后再打开。</view>
      </view>
      <switch checked="{{form.isVisible}}" bindchange="onVisibleChange" />
    </view>

    <view class="visible-row">
      <view>
        <view class="field-label">置顶显示</view>
        <view class="field-hint">仅在分类页默认排序优先展示，全部案例最多置顶 20 个。</view>
      </view>
      <switch checked="{{form.isPinned}}" bindchange="onPinnedChange" />
    </view>

    <view class="field home-section-field">
      <view class="field-label">首页展示位置</view>
      <view class="field-hint">不勾选仍可在分类页显示。轮播最多 5 张、热门最多 4 个、最新最多 6 个；名额已满时需先取消其他案例的对应展示。</view>
      <view class="chip-grid">
        <view
          wx:for="{{optionViews.homeSections}}"
          wx:key="value"
          class="chip {{item.selected ? 'chip-active' : ''}}"
          data-field="homeSections"
          data-value="{{item.value}}"
          bindtap="toggleMulti"
        >
          {{item.label || item.value}}
        </view>
      </view>
    </view>

    <view wx:if="{{!isEdit}}" class="notification-publish-card">
      <view class="visible-row notification-toggle-row">
        <view>
          <view class="field-label">同时发布产品上新通知</view>
          <view class="field-hint">默认关闭。打开后，站内公告对所有用户可见，并提醒已授权订阅的用户。</view>
        </view>
        <switch checked="{{publishProductNotification}}" color="#285f42" bindchange="onPublishNotificationChange" />
      </view>
      <view wx:if="{{publishProductNotification}}" class="notification-draft">
        <view class="field">
          <view class="field-label">通知标题</view>
          <input
            class="text-input"
            maxlength="80"
            value="{{productNotificationDraft.title}}"
            bindinput="onNotificationTitleInput"
          />
        </view>
        <view class="field">
          <view class="field-label">通知内容</view>
          <textarea
            class="textarea-input notification-textarea"
            maxlength="500"
            value="{{productNotificationDraft.content}}"
            bindinput="onNotificationContentInput"
          />
        </view>
        <view class="field-hint">案例会先保存；通知失败不会删除已保存的案例。</view>
      </view>
    </view>

    <button
      class="save-button"
      loading="{{saving}}"
      disabled="{{saving || uploading || videoUploading || posterUploading || imageProcessingFailed}}"
      bindtap="saveCase"
    >
      {{isEdit ? '保存修改' : '创建案例'}}
    </button>
  </view>
</view>
