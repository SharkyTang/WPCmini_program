<view class="page">
  <view class="hero">
    <view>
      <view class="page-title">案例管理</view>
      <view class="page-subtitle">新增、编辑、隐藏或删除酒包装案例</view>
    </view>
    <view wx:if="{{isAdmin}}" class="primary-action" bindtap="createCase">新增案例</view>
  </view>

  <view wx:if="{{isCheckingAccess}}" class="state-card">正在确认管理权限...</view>

  <view wx:elif="{{!isAdmin}}" class="state-card">
    <view class="state-title">暂无管理权限</view>
    <view class="state-desc">只有管理员可以查看和维护案例。</view>
    <view class="state-button" bindtap="retry">重新检查</view>
  </view>

  <block wx:else>
    <view class="toolbar">
      <view class="search-row">
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="搜索标题、编号、标签"
          confirm-type="search"
          bindinput="onKeywordInput"
          bindconfirm="searchCases"
        />
        <view class="search-button" bindtap="searchCases">搜索</view>
      </view>
      <view wx:if="{{keyword}}" class="clear-keyword" bindtap="clearKeyword">清空搜索</view>
      <scroll-view class="filter-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view class="filter-row">
        <view
          wx:for="{{viewOptions}}"
          wx:key="value"
          class="filter-pill {{activeView === item.value ? 'filter-pill-active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectView"
        >
          {{item.label}}
        </view>
      </view>
      </scroll-view>
    </view>

    <view wx:if="{{loading}}" class="state-card">正在读取案例...</view>

    <view wx:elif="{{errorMessage}}" class="state-card">
      <view class="state-title">读取失败</view>
      <view class="state-desc">{{errorMessage}}</view>
      <view class="state-button" bindtap="retry">重试</view>
    </view>

    <view wx:elif="{{!cases.length}}" class="state-card">
      <view class="state-title">{{emptyTitle}}</view>
      <view class="state-desc">{{emptyDescription}}</view>
      <view wx:if="{{!isHomeDisplay}}" class="state-button" bindtap="createCase">新增案例</view>
    </view>

    <view wx:else class="case-list">
      <view wx:for="{{cases}}" wx:key="displayKey" class="case-card">
        <image wx:if="{{item.coverImageUrl}}" class="case-cover" src="{{item.coverImageUrl}}" mode="aspectFill" />
        <view wx:else class="case-cover case-cover-placeholder">暂无图片</view>
        <view class="case-copy">
          <view class="case-head">
            <view class="case-title">{{item.title}}</view>
            <view wx:if="{{item.source === 'banner'}}" class="status-badge status-banner">独立轮播图</view>
            <view wx:else class="status-badge {{item.isVisible ? 'status-visible' : 'status-hidden'}}">{{item.visibilityLabel}}</view>
          </view>
          <view class="case-meta">{{item.caseId || item.id}}</view>
          <view class="case-tags">{{item.tagSummary || '暂无标签'}}</view>
          <view wx:if="{{item.homeSectionSummary}}" class="home-section-summary">首页展示：{{item.homeSectionSummary}}</view>
          <view wx:if="{{item.displayLabel}}" class="home-display-summary">{{item.displayLabel}} · {{item.displayOrderLabel}}</view>
          <view wx:if="{{item.source !== 'banner'}}" class="case-actions">
            <view class="case-action" data-id="{{item.id}}" bindtap="editCase">编辑</view>
            <view
              class="case-action danger"
              data-id="{{item.id}}"
              data-visible="{{!item.isVisible}}"
              bindtap="toggleCaseVisibility"
            >
              {{item.isVisible ? '隐藏' : '恢复'}}
            </view>
            <view
              class="case-action delete"
              data-id="{{item.id}}"
              bindtap="deleteCase"
            >
              删除
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{!isHomeDisplay && loadingMore}}" class="list-foot">继续读取...</view>
      <view wx:elif="{{!isHomeDisplay && !hasMore}}" class="list-foot">已显示全部案例</view>
    </view>
  </block>
</view>
