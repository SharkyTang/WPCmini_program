page {
  min-height: 100%;
  background: #f5efe4;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fff8ef 0%, rgba(255, 248, 239, 0) 340rpx),
    #f5efe4;
  padding: 54rpx 34rpx 96rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.4;
}

.form-card,
.state-card {
  border: 2rpx solid rgba(223, 207, 183, 0.86);
  border-radius: 8rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 30rpx rgba(72, 49, 25, 0.08);
  box-sizing: border-box;
}

.form-card {
  padding: 30rpx;
  background: linear-gradient(180deg, #fffdf8 0%, #fff8ef 100%);
}

.form-section-title {
  margin: 4rpx 0 22rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #b77a2d;
  color: #241d16;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 900;
}

.field + .form-section-title,
.visible-row + .form-section-title,
.home-section-field + .form-section-title,
.notification-publish-card + .form-section-title {
  margin-top: 42rpx;
}

.notification-publish-card {
  margin: 34rpx 0;
  padding: 8rpx 24rpx 24rpx;
  border: 2rpx solid #d8c39f;
  border-radius: 8rpx;
  background: #fff8eb;
}

.notification-toggle-row {
  padding-bottom: 0;
}

.notification-draft {
  margin-top: 20rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #eadcc6;
}

.notification-draft .field:last-of-type {
  margin-bottom: 12rpx;
}

.notification-textarea {
  min-height: 150rpx;
}

.state-card {
  min-height: 220rpx;
  padding: 44rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.5;
}

.state-title {
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.state-desc {
  margin-top: 12rpx;
}

.field {
  margin-bottom: 30rpx;
}

.field-label {
  color: #241d16;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.field-hint {
  margin-top: 8rpx;
  color: #8c8176;
  font-size: 21rpx;
  line-height: 1.45;
}

.cover-picker {
  position: relative;
  margin-top: 16rpx;
  width: 260rpx;
  height: 200rpx;
  border: 2rpx dashed #d7bd96;
  border-radius: 8rpx;
  background: #fff7e7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.gallery-grid {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.gallery-upload-wrap {
  position: relative;
}

.gallery-upload-wrap .upload-mask {
  right: 0;
  bottom: 0;
  border-radius: 8rpx;
}

.gallery-item,
.cover-picker {
  position: relative;
  width: 188rpx;
  height: 148rpx;
  box-sizing: border-box;
}

.gallery-item {
  overflow: hidden;
  border: 2rpx solid #e1cdae;
  border-radius: 8rpx;
  background: #fff7e7;
  box-shadow: 0 8rpx 18rpx rgba(72, 49, 25, 0.08);
}

.gallery-preview {
  width: 100%;
  height: 100%;
}

.gallery-cover-badge,
.gallery-actions {
  position: absolute;
  z-index: 1;
}

.gallery-cover-badge {
  top: 8rpx;
  left: 8rpx;
  padding: 4rpx 10rpx;
  border-radius: 16rpx;
  background: #285f42;
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
}

.gallery-actions {
  right: 6rpx;
  bottom: 6rpx;
  display: flex;
  gap: 6rpx;
}

.gallery-action {
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: rgba(36, 29, 22, 0.86);
  color: #fff;
  font-size: 21rpx;
  line-height: 34rpx;
  text-align: center;
}

.gallery-remove { background: #a33b31; }
.gallery-count { margin-top: 5rpx; font-size: 19rpx; }

.cover-empty,
.upload-mask {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8c8176;
  font-size: 23rpx;
}

.cover-plus {
  margin-bottom: 8rpx;
  font-size: 48rpx;
  line-height: 1;
}

.upload-mask {
  position: absolute;
  left: 0;
  top: 0;
  background: rgba(36, 29, 22, 0.58);
  color: #fff;
  font-weight: 800;
}

.text-input,
.textarea-input {
  margin-top: 14rpx;
  width: 100%;
  border: 2rpx solid #e0cfb8;
  border-radius: 8rpx;
  background: #fff;
  color: #241d16;
  box-sizing: border-box;
  font-size: 25rpx;
}

.text-input {
  height: 76rpx;
  padding: 0 22rpx;
}

.textarea-input {
  min-height: 180rpx;
  padding: 20rpx 22rpx;
  line-height: 1.45;
}

.chip-row,
.chip-grid {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.chip {
  min-height: 56rpx;
  padding: 0 24rpx;
  border: 2rpx solid #e0cfb8;
  border-radius: 28rpx;
  background: #fff;
  color: #766b60;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
}

.chip-active {
  border-color: #b77a2d;
  background: #2a2119;
  color: #fff;
}

.visible-row {
  margin: 6rpx 0 34rpx;
  padding: 22rpx 0;
  border: 2rpx solid #eadcca;
  border-radius: 8rpx;
  background: #fffdf8;
  padding: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.home-section-field {
  margin-top: -10rpx;
  padding-bottom: 8rpx;
}

.image-retry-button {
  margin: 18rpx 0 0;
  border: 2rpx solid #b77a2d;
  border-radius: 8rpx;
  background: #fff8ed;
  color: #8b571c;
  font-size: 24rpx;
  font-weight: 700;
}

.image-retry-button::after {
  border: none;
}

.video-upload-card {
  margin-bottom: 36rpx;
  padding: 24rpx;
  border: 2rpx solid #e0cfb8;
  border-radius: 8rpx;
  background: #fffdf8;
}

.video-source-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.video-source-option {
  min-height: 58rpx;
  padding: 0 22rpx;
  border: 2rpx solid #d8c39f;
  border-radius: 8rpx;
  background: #fff8eb;
  color: #76512b;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.video-source-option-active {
  border-color: #285f42;
  background: #285f42;
  color: #fff;
}

.video-source-option-disabled {
  opacity: 0.55;
}

.video-disabled-hint {
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: #f3ede4;
  color: #71665b;
  font-size: 21rpx;
  line-height: 1.45;
}

.video-advanced-toggle {
  flex: 1;
  color: #6d6257;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: right;
}

.video-upload-body {
  margin-top: 22rpx;
}

.video-admin-preview,
.video-empty-state {
  width: 100%;
  height: 330rpx;
  border-radius: 8rpx;
  background: #1f1a15;
  overflow: hidden;
}

.video-empty-state {
  border: 2rpx dashed #d7bd96;
  background: #fff7e7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.video-empty-title {
  color: #4b3a28;
  font-size: 27rpx;
  font-weight: 800;
}

.video-meta-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  color: #6f6255;
  font-size: 21rpx;
}

.video-meta-row text {
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
  background: #f2e8d9;
}

.video-progress-block {
  margin-top: 16rpx;
}

.video-progress-track {
  height: 12rpx;
  border-radius: 6rpx;
  background: #eadfce;
  overflow: hidden;
}

.video-progress-value {
  height: 100%;
  border-radius: 6rpx;
  background: #285f42;
  transition: width 0.2s ease;
}

.video-error-text {
  margin-top: 12rpx;
  color: #a33b31;
  font-size: 22rpx;
  line-height: 1.4;
}

.video-action-row {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.video-action-button {
  min-width: 150rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid #d8c39f;
  border-radius: 8rpx;
  background: #fff8eb;
  color: #76512b;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.video-action-button::after {
  border: none;
}

.video-action-primary {
  border-color: #285f42;
  background: #285f42;
  color: #fff;
}

.video-action-danger {
  border-color: #d8b8b2;
  background: #fff7f5;
  color: #a33b31;
}

.video-poster-section,
.video-external-panel {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #eadcc6;
}

.video-poster-preview {
  width: 240rpx;
  height: 152rpx;
  margin-top: 14rpx;
  border: 2rpx solid #e0cfb8;
  border-radius: 8rpx;
  background: #f2e8d9;
}

.video-external-field {
  margin-top: 22rpx;
  margin-bottom: 0;
}

.video-external-preview {
  margin-top: 20rpx;
}

.video-unsaved-hint {
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: #fff1d8;
  color: #875817;
  font-size: 21rpx;
  line-height: 1.45;
}

.save-button {
  height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #241d16 0%, #4a3520 100%);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(36, 29, 22, 0.18);
  font-size: 27rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-button::after {
  border: none;
}
