page {
  min-height: 100%;
  background: #f7f3ec;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 54rpx 34rpx 96rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.4;
}

.form-card,
.state-card {
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fffdf9;
  box-sizing: border-box;
}

.form-card {
  padding: 28rpx;
}

.state-card {
  min-height: 220rpx;
  padding: 44rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.5;
}

.state-title {
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.state-desc {
  margin-top: 12rpx;
}

.field {
  margin-bottom: 30rpx;
}

.field-label {
  color: #241d16;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.field-hint {
  margin-top: 8rpx;
  color: #8c8176;
  font-size: 21rpx;
  line-height: 1.45;
}

.cover-picker {
  position: relative;
  margin-top: 16rpx;
  width: 260rpx;
  height: 200rpx;
  border: 2rpx dashed #dfcfb7;
  border-radius: 8rpx;
  background: #f8f0e4;
  overflow: hidden;
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-empty,
.upload-mask {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8c8176;
  font-size: 23rpx;
}

.cover-plus {
  margin-bottom: 8rpx;
  font-size: 48rpx;
  line-height: 1;
}

.upload-mask {
  position: absolute;
  left: 0;
  top: 0;
  background: rgba(36, 29, 22, 0.58);
  color: #fff;
  font-weight: 800;
}

.text-input,
.textarea-input {
  margin-top: 14rpx;
  width: 100%;
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fffdf9;
  color: #241d16;
  box-sizing: border-box;
  font-size: 25rpx;
}

.text-input {
  height: 76rpx;
  padding: 0 22rpx;
}

.textarea-input {
  min-height: 180rpx;
  padding: 20rpx 22rpx;
  line-height: 1.45;
}

.chip-row,
.chip-grid {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.chip {
  min-height: 56rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 28rpx;
  background: #fffdf9;
  color: #766b60;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
}

.chip-active {
  border-color: #241d16;
  background: #241d16;
  color: #fff;
}

.visible-row {
  margin: 6rpx 0 34rpx;
  padding: 22rpx 0;
  border-top: 2rpx solid #eee4d7;
  border-bottom: 2rpx solid #eee4d7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.save-button {
  height: 84rpx;
  border-radius: 42rpx;
  background: #241d16;
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-button::after {
  border: none;
}
