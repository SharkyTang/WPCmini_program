page {
  min-height: 100%;
  background: #f5efe4;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 54rpx 34rpx 104rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #fff8ef 0%, rgba(255, 248, 239, 0) 340rpx),
    #f5efe4;
}

.hero {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.page-subtitle,
.section-subtitle,
.state-desc,
.field-hint,
.empty-tip {
  color: #766b60;
  font-size: 23rpx;
  line-height: 1.5;
}

.page-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.state-card,
.section {
  border: 2rpx solid rgba(223, 207, 183, 0.86);
  border-radius: 8rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 30rpx rgba(72, 49, 25, 0.08);
  box-sizing: border-box;
}

.state-card {
  min-height: 230rpx;
  padding: 44rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.state-desc {
  margin-top: 12rpx;
}

.state-button {
  width: 240rpx;
  margin-top: 26rpx;
}

.inline-message {
  margin-bottom: 22rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid #e5b2aa;
  border-radius: 8rpx;
  background: #fff2ef;
  color: #a33b31;
  font-size: 23rpx;
  line-height: 1.5;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section:first-of-type {
  margin-top: 0;
}

.section-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border-radius: 4rpx;
  background: #b77a2d;
  vertical-align: -3rpx;
}

.section-subtitle {
  margin-top: 8rpx;
}

.gallery-grid {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.gallery-item {
  position: relative;
  width: calc(50% - 7rpx);
  height: 210rpx;
  overflow: hidden;
  border: 2rpx solid #e1cdae;
  border-radius: 8rpx;
  background: #f3e6d4;
  box-sizing: border-box;
}

.gallery-image {
  display: block;
  width: 100%;
  height: 100%;
}

.cover-badge,
.pending-badge {
  position: absolute;
  top: 10rpx;
  z-index: 1;
  padding: 5rpx 11rpx;
  border-radius: 18rpx;
  color: #fff;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 800;
}

.cover-badge {
  left: 10rpx;
  background: #285f42;
}

.pending-badge {
  right: 10rpx;
  background: #8f5d22;
}

.gallery-actions {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  z-index: 2;
  display: flex;
  gap: 7rpx;
}

.image-action {
  width: 48rpx;
  min-width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  background: rgba(36, 29, 22, 0.88);
  color: #fff;
  font-size: 25rpx;
  line-height: 48rpx;
  text-align: center;
}

.image-action::after,
.secondary-button::after,
.qr-remove-button::after,
.save-button::after {
  border: none;
}

.remove-action {
  background: rgba(163, 59, 49, 0.94);
}

.empty-tip {
  margin-top: 22rpx;
  padding: 24rpx;
  border: 2rpx dashed #d7bd96;
  border-radius: 8rpx;
  background: #fff8ed;
  text-align: center;
}

.secondary-button {
  min-height: 72rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  border: 2rpx solid #b77a2d;
  border-radius: 36rpx;
  background: #fff8ed;
  color: #8b571c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
}

.secondary-button[disabled] {
  border-color: #d9cdbc;
  background: #f2ede5;
  color: #9c9389;
  opacity: 1;
}

.qr-preview-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.qr-preview-shell {
  position: relative;
  width: 420rpx;
  max-width: 100%;
  margin: 0 auto;
  padding: 18rpx;
  border: 2rpx solid #eadcca;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
}

.qr-preview {
  display: block;
  width: 100%;
}

.qr-pending {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  padding: 5rpx 12rpx;
  border-radius: 18rpx;
  background: #8f5d22;
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
}

.qr-remove-button {
  width: 100%;
  height: 64rpx;
  margin: 16rpx 0 0;
  padding: 0 20rpx;
  border: 2rpx solid #c88f85;
  border-radius: 32rpx;
  background: #fff2ef;
  color: #a33b31;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 60rpx;
  box-sizing: border-box;
}

.phone-field {
  margin-top: 24rpx;
}

.field-label {
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
}

.text-input {
  width: 100%;
  height: 78rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  border: 2rpx solid #e0cfb8;
  border-radius: 8rpx;
  background: #fff;
  color: #241d16;
  box-sizing: border-box;
  font-size: 25rpx;
}

.field-hint {
  margin-top: 14rpx;
}

.save-button {
  height: 86rpx;
  margin-top: 32rpx;
  border-radius: 43rpx;
  background: linear-gradient(135deg, #241d16 0%, #4a3520 100%);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(36, 29, 22, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
}

.save-button[disabled] {
  opacity: 0.68;
}
