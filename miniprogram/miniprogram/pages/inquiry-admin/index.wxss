page {
  min-height: 100%;
  background: var(--brand-bg);
  color: var(--brand-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 58rpx 30rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 26rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.summary-grid {
  margin-bottom: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-card {
  padding: 20rpx 14rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 8rpx;
  background: var(--brand-surface);
  text-align: center;
}

.summary-card-primary {
  border-color: var(--brand-gold);
  background: var(--brand-gold-soft);
}

.summary-value {
  color: var(--brand-ink);
  font-size: 36rpx;
  line-height: 1.1;
  font-weight: 800;
}

.summary-label {
  margin-top: 8rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
}

.alert-banner,
.summary-error {
  margin-bottom: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
}

.alert-banner {
  border: 2rpx solid #d68b7d;
  background: #fff1ed;
  color: var(--brand-red);
}

.summary-error {
  background: #f5ecdf;
  color: #80531f;
}

.status-scroll {
  width: 100%;
  white-space: nowrap;
}

.status-row {
  display: inline-flex;
  gap: 14rpx;
  padding-bottom: 18rpx;
}

.claim-filter-row {
  margin: 0 0 18rpx;
  display: flex;
  gap: 12rpx;
}

.claim-filter {
  min-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: #eee6dc;
  color: var(--brand-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

.claim-filter-active {
  background: var(--brand-green-soft);
  color: var(--brand-green);
}

.status-pill {
  height: 58rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 29rpx;
  background: #fffdf9;
  color: #766b60;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.status-pill-active {
  background: #241d16;
  border-color: #241d16;
  color: #fff;
}

.search-card,
.state-card,
.inquiry-card {
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-sizing: border-box;
}

.search-card {
  min-height: 78rpx;
  padding: 10rpx 14rpx 10rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 58rpx;
  color: #241d16;
  font-size: 24rpx;
}

.search-action,
.search-clear {
  color: #b97832;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.search-clear {
  color: #8c8176;
}

.state-card {
  margin-top: 22rpx;
  padding: 40rpx 28rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.state-title {
  color: #241d16;
  font-size: 30rpx;
  font-weight: 800;
}

.state-text {
  margin-top: 10rpx;
}

.state-button {
  margin: 24rpx auto 0;
  width: 180rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
}

.inquiry-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.inquiry-card {
  position: relative;
  padding: 24rpx 24rpx 24rpx 30rpx;
  overflow: hidden;
  box-shadow: var(--brand-shadow);
}

.inquiry-card::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  background: var(--brand-gold);
}

.inquiry-card-processing::before {
  background: var(--brand-green);
}

.inquiry-card-done::before {
  background: #8c8176;
}

.inquiry-card-invalid::before {
  background: var(--brand-red);
}

.inquiry-card:active {
  opacity: 0.86;
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.badge-row {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.status-badge {
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 21rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  font-size: 21rpx;
  font-weight: 800;
}

.claim-badge,
.warning-badge {
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 21rpx;
  display: flex;
  align-items: center;
  font-size: 19rpx;
  font-weight: 800;
}

.claim-unclaimed {
  background: #f4e8d6;
  color: #9a6125;
}

.claim-claimed {
  background: #ece8e3;
  color: #766b60;
}

.claim-mine {
  background: var(--brand-green-soft);
  color: var(--brand-green);
}

.warning-badge {
  background: #fff1ed;
  color: var(--brand-red);
}

.status-new {
  background: var(--brand-gold);
}

.status-contacted {
  background: #9a6125;
}

.status-processing {
  background: var(--brand-green);
}

.status-done {
  background: #8c8176;
}

.status-invalid {
  background: var(--brand-red);
}

.created-time {
  color: #8c8176;
  font-size: 21rpx;
  white-space: nowrap;
}

.contact-label {
  margin-top: 20rpx;
  color: var(--brand-muted);
  font-size: 20rpx;
  line-height: 1.4;
}

.contact-line {
  margin-top: 4rpx;
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
  word-break: break-all;
}

.legacy-warning {
  margin-top: 10rpx;
  color: #a66018;
  font-size: 21rpx;
  font-weight: 700;
}

.meta-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.meta-item {
  min-width: 0;
  padding: 10rpx 12rpx;
  border-radius: 6rpx;
  background: var(--brand-gold-soft);
  color: #80531f;
  font-size: 20rpx;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.source-line,
.case-line,
.content-preview {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 23rpx;
  line-height: 1.45;
}

.content-preview {
  color: #241d16;
}

.last-reply {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 6rpx;
  background: var(--brand-green-soft);
  color: var(--brand-green);
  font-size: 21rpx;
  line-height: 1.45;
}

.list-tip {
  padding: 20rpx 0 6rpx;
  color: #8c8176;
  font-size: 22rpx;
  text-align: center;
}

.refresh-tip {
  padding: 26rpx 0 4rpx;
  color: #a3978a;
  font-size: 20rpx;
  text-align: center;
}
