page {
  min-height: 100%;
  background: var(--brand-bg);
  color: var(--brand-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 58rpx 30rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 26rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.section,
.state-card {
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
  box-sizing: border-box;
}

.section {
  margin-top: 22rpx;
  padding: 28rpx;
}

.section-title,
.state-title {
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.section-kicker {
  color: var(--brand-gold);
  font-size: 19rpx;
  line-height: 1.4;
  font-weight: 800;
}

.section-title {
  margin-top: 4rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.status-badge {
  margin-top: 8rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 800;
}

.status-new {
  background: var(--brand-gold);
}

.status-contacted {
  background: #9a6125;
}

.status-processing {
  background: var(--brand-green);
}

.status-done {
  background: #8c8176;
}

.status-invalid {
  background: var(--brand-red);
}

.status-picker,
.copy-button,
.outline-button {
  min-height: 58rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 8rpx;
  color: var(--brand-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.contact-card {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: var(--brand-green-soft);
}

.contact-label {
  color: var(--brand-green);
  font-size: 21rpx;
  line-height: 1.4;
  font-weight: 700;
}

.contact-value {
  margin-top: 8rpx;
  color: var(--brand-ink);
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
  word-break: break-all;
}

.contact-meta {
  margin-top: 8rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
  line-height: 1.4;
}

.info-row {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.info-label {
  width: 140rpx;
  color: #8c8176;
  font-size: 23rpx;
  line-height: 1.45;
  flex: 0 0 140rpx;
}

.info-value {
  min-width: 0;
  flex: 1;
  color: #241d16;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 700;
}

.copy-button,
.outline-button {
  margin-top: 24rpx;
  width: 230rpx;
}

.content-box {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: var(--brand-bg);
  color: #241d16;
  font-size: 24rpx;
  line-height: 1.6;
  white-space: pre-wrap;
}

.note-input {
  margin-top: 20rpx;
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx;
  border: 2rpx solid var(--brand-line);
  border-radius: 8rpx;
  background: #fffdf9;
  color: #241d16;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.note-count {
  margin-top: 8rpx;
  color: #a3978a;
  font-size: 20rpx;
  text-align: right;
}

.save-button,
.state-button {
  margin-top: 24rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: var(--brand-ink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.save-button-disabled {
  opacity: 0.56;
}

.state-card {
  margin-top: 22rpx;
  padding: 40rpx 28rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.state-text {
  margin-top: 10rpx;
}

.state-button {
  margin-left: auto;
  margin-right: auto;
  width: 180rpx;
}

.dialog-content {
  padding: 8rpx 4rpx 18rpx;
  color: var(--brand-muted);
  font-size: 25rpx;
  line-height: 1.55;
}
