<view class="page">
  <view class="hero">
    <view class="hero-copy">
      <view class="page-title">联系我们</view>
      <view class="page-subtitle">欢迎到店沟通酒包装设计与定制需求</view>
    </view>
    <button
      wx:if="{{isAdmin}}"
      class="admin-edit-button"
      bindtap="openContactAdmin"
    >
      编辑联系信息
    </button>
  </view>

  <view class="section store-section">
    <view class="section-heading">
      <view>
        <view class="section-title">门店实景</view>
        <view class="section-subtitle">左右滑动查看更多，点击图片可放大</view>
      </view>
      <view class="image-count">
        {{activeStoreImageIndex + 1}} / {{storeImages.length}}
      </view>
    </view>

    <swiper
      class="store-swiper"
      current="{{activeStoreImageIndex}}"
      circular="{{storeImages.length > 1}}"
      indicator-dots="{{storeImages.length > 1}}"
      indicator-color="rgba(255,255,255,0.55)"
      indicator-active-color="#ffffff"
      bindchange="onStoreImageChange"
    >
      <swiper-item wx:for="{{storeImages}}" wx:key="*this">
        <image
          class="store-image"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewStoreImage"
        />
      </swiper-item>
    </swiper>
  </view>

  <view class="section address-section">
    <view class="section-title">门店地址</view>
    <view class="address-row">
      <view class="location-mark">
        <view class="location-dot"></view>
      </view>
      <view class="address-copy">
        <view class="store-name">{{storeName}}</view>
        <view class="store-address">{{address}}</view>
      </view>
    </view>
    <view class="map-button" bindtap="openStoreLocation">
      <view class="map-button-icon">⌖</view>
      <view>打开地图导航</view>
    </view>
  </view>

  <view class="section phone-section">
    <view class="section-title">联系电话</view>
    <view wx:if="{{phoneNumbers.length}}" class="phone-list">
      <view
        wx:for="{{phoneNumbers}}"
        wx:key="dialNumber"
        class="phone-row"
      >
        <view class="phone-copy">
          <view class="phone-label">联系电话 {{index + 1}}</view>
          <view class="phone-number">{{item.displayNumber}}</view>
        </view>
        <button
          class="phone-call-button"
          data-index="{{index}}"
          bindtap="callPhone"
        >
          一键拨打
        </button>
      </view>
    </view>
    <view wx:else class="phone-empty">联系电话暂未配置</view>
  </view>

  <view class="section qr-section">
    <view class="section-title">添加微信咨询</view>
    <view class="section-subtitle qr-tip">点击放大，或长按识别二维码</view>
    <view class="qr-image-shell">
      <image
        class="qr-image"
        src="{{wechatQrImage}}"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
        bindtap="previewWechatQr"
      />
    </view>
  </view>
</view>
