page {
  min-height: 100%;
  background: #f7f3ec;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 58rpx 40rpx 104rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 26rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.tab-scroll {
  width: 100%;
  margin-bottom: 26rpx;
  white-space: nowrap;
}

.tab-list {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.tab-item {
  flex: 0 0 auto;
  min-width: 112rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 29rpx;
  background: #fffdf9;
  color: #8c6a3f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.tab-item-active {
  border-color: #241d16;
  background: #241d16;
  color: #fffdf9;
}

.settings-card,
.state-card,
.notification-card {
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fffdf9;
  box-sizing: border-box;
}

.settings-card,
.state-card {
  padding: 40rpx 34rpx;
}

.settings-title,
.state-title {
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
}

.settings-copy,
.state-copy {
  margin-top: 12rpx;
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.55;
}

.settings-list {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.setting-row {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.setting-name {
  color: #241d16;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.setting-state {
  margin-top: 6rpx;
  color: #8c6a3f;
  font-size: 22rpx;
  line-height: 1.35;
}

.state-error {
  border-color: #efc3ba;
  background: #fff5f2;
}

.state-button {
  margin-top: 30rpx;
  width: 300rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.notification-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notification-card {
  padding: 26rpx 28rpx;
}

.notification-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.notification-type {
  min-width: 112rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: #241d16;
  color: #fffdf9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.notification-time {
  color: #9d8d78;
  font-size: 22rpx;
  line-height: 1.35;
}

.notification-title {
  margin-top: 18rpx;
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
}

.notification-content {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.55;
}
