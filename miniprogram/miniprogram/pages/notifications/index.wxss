page {
  min-height: 100%;
  background: var(--brand-bg);
  color: var(--brand-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 58rpx 40rpx 104rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 26rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.tab-scroll {
  width: 100%;
  margin-bottom: 26rpx;
  white-space: nowrap;
}

.tab-list {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.tab-item {
  flex: 0 0 auto;
  min-width: 112rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 29rpx;
  background: #fffdf9;
  color: #8c6a3f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.tab-item-active {
  border-color: #241d16;
  background: #241d16;
  color: #fffdf9;
}

.settings-card,
.notification-card {
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
  box-sizing: border-box;
}

.settings-card {
  padding: 40rpx 34rpx;
}

.settings-title,
.state-title {
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
}

.settings-copy,
.state-copy {
  margin-top: 12rpx;
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.55;
}

.settings-list {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.setting-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.setting-copy {
  flex: 1;
  min-width: 0;
}

.setting-name {
  color: #241d16;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.setting-state {
  margin-top: 6rpx;
  color: #8c6a3f;
  font-size: 22rpx;
  line-height: 1.35;
}

.subscribe-button {
  flex: 0 0 192rpx;
  width: 192rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #241d16;
  color: #fffdf9;
  font-size: 22rpx;
  line-height: 64rpx;
  font-weight: 800;
}

.subscribe-button::after {
  border: 0;
}

.subscribe-button[disabled],
.subscribe-button-done {
  background: #e5eee8;
  color: #285f42;
  opacity: 1;
}

.settings-footnote {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #eee3d4;
  color: #8c8176;
  font-size: 21rpx;
  line-height: 1.5;
}

.state-shell {
  padding: 16rpx 24rpx 38rpx;
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
  text-align: center;
}

.state-error {
  background: var(--brand-red-soft);
}

.state-button {
  margin: 4rpx auto 0;
  width: 300rpx;
  height: 68rpx;
  border-radius: 8rpx;
  background: var(--brand-ink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.notification-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notification-card {
  position: relative;
  padding: 28rpx 28rpx 28rpx 34rpx;
  overflow: hidden;
}

.notification-card::before {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  background: var(--brand-gold);
}

.notification-product_new::before {
  background: var(--brand-green);
}

.notification-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.notification-type {
  min-width: 112rpx;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: var(--brand-gold-soft);
  color: #80531f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.notification-product_new .notification-type {
  background: var(--brand-green-soft);
  color: var(--brand-green);
}

.notification-time {
  color: #a3978a;
  font-size: 20rpx;
  line-height: 1.35;
}

.notification-title {
  margin-top: 18rpx;
  color: #241d16;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 800;
}

.notification-content {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.55;
}

.notification-card-link {
  cursor: pointer;
}

.notification-link {
  margin-top: 16rpx;
  color: #285f42;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 800;
}
