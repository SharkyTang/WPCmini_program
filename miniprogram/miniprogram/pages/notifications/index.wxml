<view class="page">
  <view class="hero">
    <view class="page-title">消息通知</view>
    <view class="page-subtitle">查看版本更新和产品上新，客服消息请通过官方客服入口查看</view>
  </view>

  <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab-list">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{activeTab === item.key ? 'tab-item-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchTab"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{activeTab === 'settings'}}" class="settings-card">
    <view class="settings-title">通知设置</view>
    <view class="settings-copy">微信订阅为一次性授权。收到下一条提醒后，需要再次主动订阅。</view>
    <view class="settings-list">
      <view
        wx:for="{{subscriptionItems}}"
        wx:key="type"
        class="setting-row"
      >
        <view class="setting-copy">
          <view class="setting-name">{{item.label}}</view>
          <view class="setting-state">{{item.stateText}}</view>
        </view>
        <button
          class="subscribe-button {{item.status === 'granted' ? 'subscribe-button-done' : ''}}"
          loading="{{subscribingType === item.type}}"
          disabled="{{item.actionDisabled || subscribingType}}"
          data-type="{{item.type}}"
          bindtap="subscribeNext"
        >
          {{item.actionLabel}}
        </button>
      </view>
    </view>
    <view class="settings-footnote">即使未订阅微信提醒，所有公开通知仍会保留在本页面中。</view>
  </view>

  <view wx:elif="{{loading}}" class="state-shell">
    <mp-msg type="waiting" title="正在读取消息通知" desc="正在同步最新内容" />
  </view>

  <view wx:elif="{{errorMessage}}" class="state-shell state-error">
    <mp-msg type="warn" title="消息读取失败" desc="{{errorMessage}}" />
    <view class="state-button" bindtap="loadNotifications">重新读取</view>
  </view>

  <view wx:elif="{{!displayNotifications.length}}" class="state-shell">
    <mp-msg
      type="info"
      title="暂无消息通知"
      desc="有新的通知后会出现在这里"
    />
  </view>

  <view wx:else class="notification-list">
    <view
      wx:for="{{displayNotifications}}"
      wx:key="id"
      class="notification-card notification-{{item.type}} {{item.hasCaseLink ? 'notification-card-link' : ''}}"
      data-target="{{item.hasCaseLink ? item.targetPage : ''}}"
      bindtap="openNotification"
    >
      <view class="notification-meta">
        <view class="notification-type">{{item.typeLabel}}</view>
        <view class="notification-time">{{item.timeText}}</view>
      </view>
      <view class="notification-title">{{item.title}}</view>
      <view class="notification-content">{{item.content}}</view>
      <view wx:if="{{item.hasCaseLink}}" class="notification-link">查看对应案例 ›</view>
    </view>
  </view>
</view>
