<view class="page">
  <view class="hero">
    <view class="page-title">消息通知</view>
    <view class="page-subtitle">查看版本更新、产品上新和客服回复</view>
  </view>

  <scroll-view class="tab-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab-list">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{activeTab === item.key ? 'tab-item-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchTab"
      >
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{activeTab === 'settings'}}" class="settings-card">
    <view class="settings-title">通知设置</view>
    <view class="settings-copy">关闭后不主动提醒，但仍可在消息页查看。</view>
    <view class="settings-list">
      <view
        wx:for="{{settingItems}}"
        wx:key="type"
        class="setting-row"
      >
        <view>
          <view class="setting-name">{{item.label}}</view>
          <view class="setting-state">{{item.disabled ? '已关闭提醒' : '已开启提醒'}}</view>
        </view>
        <switch
          checked="{{!item.disabled}}"
          color="#285f42"
          data-type="{{item.type}}"
          bindchange="toggleSetting"
        />
      </view>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="state-shell">
    <mp-msg type="waiting" title="正在读取消息通知" desc="正在同步最新内容" />
  </view>

  <view wx:elif="{{errorMessage}}" class="state-shell state-error">
    <mp-msg type="warn" title="消息读取失败" desc="{{errorMessage}}" />
    <view class="state-button" bindtap="loadNotifications">重新读取</view>
  </view>

  <view wx:elif="{{needCustomerIdentity}}" class="state-shell">
    <mp-msg type="info" title="完善个人资料" desc="完善资料后可识别并保护只属于你的客服回复" />
    <view class="state-button" bindtap="loginAndLoadCustomer">去完善资料</view>
  </view>

  <view wx:elif="{{!displayNotifications.length}}" class="state-shell">
    <mp-msg
      type="info"
      title="{{activeTab === 'customer_reply' ? '暂无客服回复' : '暂无消息通知'}}"
      desc="有新的通知后会出现在这里"
    />
  </view>

  <view wx:else class="notification-list">
    <view
      wx:for="{{displayNotifications}}"
      wx:key="id"
      class="notification-card notification-{{item.type}}"
    >
      <view class="notification-meta">
        <view class="notification-type">{{item.typeLabel}}</view>
        <view class="notification-time">{{item.timeText}}</view>
      </view>
      <view class="notification-title">{{item.title}}</view>
      <view class="notification-content">{{item.content}}</view>
    </view>
  </view>
</view>
