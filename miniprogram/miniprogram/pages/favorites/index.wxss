page {
  min-height: 100%;
  background: var(--brand-bg);
  color: var(--brand-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 54rpx 36rpx 118rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 30rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.manage-button {
  flex: 0 0 auto;
  min-width: 92rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 28rpx;
  background: #fffdf9;
  color: #8c6a3f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.state-shell {
  padding: 16rpx 24rpx 38rpx;
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
  box-sizing: border-box;
  text-align: center;
}

.state-error {
  background: var(--brand-red-soft);
}

.state-button {
  margin: 4rpx auto 0;
  width: 260rpx;
  height: 68rpx;
  border-radius: 8rpx;
  background: var(--brand-ink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.favorites-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.favorites-grid-manage {
  padding-bottom: 104rpx;
}

.manage-toolbar {
  margin-bottom: 24rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fffdf9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.manage-count {
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.3;
}

.manage-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.manage-action {
  color: #8c6a3f;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 800;
}

.manage-action-danger {
  color: #b8503a;
}

.case-card {
  min-width: 0;
  position: relative;
  padding: 10rpx;
  border: 2rpx solid transparent;
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
  box-sizing: border-box;
}

.case-card-manage {
  box-shadow: none;
}

.case-card-selected {
  border-color: var(--brand-gold);
  background: var(--brand-gold-soft);
}

.select-mark {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 2;
}

.select-dot {
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid #241d16;
  border-radius: 50%;
  background: rgba(255, 253, 249, 0.92);
  color: #fffdf9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}

.case-card-selected .select-dot {
  border-color: var(--brand-green);
  background: var(--brand-green);
}

.case-image,
.case-placeholder {
  width: 100%;
  aspect-ratio: 1.22;
  border-radius: 6rpx;
  background: #f5e2ae;
}

.case-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9d8d78;
  font-size: 22rpx;
}

.case-title {
  margin-top: 13rpx;
  color: #241d16;
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.case-tags {
  margin-top: 7rpx;
  color: #8c6a3f;
  font-size: 22rpx;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bottom-manage-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(245, 239, 228, 0.97);
  border-top: 2rpx solid #eadcc8;
  box-sizing: border-box;
  z-index: 10;
}

.cancel-selected-button {
  height: 76rpx;
  border-radius: 8rpx;
  background: var(--brand-red);
  color: #fffdf9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.cancel-selected-button-disabled {
  background: #d7cbbd;
  color: #fffdf9;
}

.dialog-content {
  padding: 8rpx 4rpx 18rpx;
  color: var(--brand-muted);
  font-size: 25rpx;
  line-height: 1.55;
}
