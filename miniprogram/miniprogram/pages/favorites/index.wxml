<view class="page">
  <view class="hero">
    <view>
      <view class="page-title">我的收藏</view>
      <view class="page-subtitle">这里保存你喜欢的酒包装案例</view>
    </view>
    <view
      wx:if="{{favoriteCards.length}}"
      class="manage-button"
      bindtap="toggleManageMode"
    >
      {{manageMode ? '完成' : '管理'}}
    </view>
  </view>

  <view wx:if="{{profileBlocked}}" class="state-card">
    <view class="state-title">完善个人资料后可查看收藏</view>
    <view class="state-copy">资料会用于保存你的收藏，并在换设备后继续查看。</view>
    <view class="state-button" bindtap="ensureProfileAndLoad">去完善资料</view>
  </view>

  <view wx:elif="{{loading}}" class="state-card">
    <view class="state-title">正在读取收藏...</view>
  </view>

  <view wx:elif="{{errorMessage}}" class="state-card state-error">
    <view class="state-title">{{errorMessage}}</view>
    <view class="state-button" bindtap="loadFavorites">重新读取</view>
  </view>

  <view wx:elif="{{!favoriteCards.length}}" class="state-card">
    <view class="state-title">还没有收藏案例</view>
    <view class="state-copy">进入案例详情页，点击收藏后会出现在这里。</view>
    <view class="state-button" bindtap="goToCategory">去看案例</view>
  </view>

  <view wx:else>
    <view wx:if="{{manageMode}}" class="manage-toolbar">
      <view class="manage-count">已选择 {{selectedCount}} 条</view>
      <view class="manage-actions">
        <view class="manage-action" bindtap="toggleSelectAll">
          {{selectedCount === favoriteCards.length ? '取消全选' : '全选'}}
        </view>
        <view class="manage-action manage-action-danger" bindtap="clearAllFavorites">删除全部</view>
      </view>
    </view>

    <view class="favorites-grid {{manageMode ? 'favorites-grid-manage' : ''}}">
      <view
        wx:for="{{favoriteCards}}"
        wx:key="favoriteId"
        class="case-card {{manageMode ? 'case-card-manage' : ''}} {{item.selected ? 'case-card-selected' : ''}}"
        data-id="{{item.id}}"
        data-favorite-id="{{item.favoriteId}}"
        bindtap="handleCardTap"
      >
        <view wx:if="{{manageMode}}" class="select-mark">
          <view class="select-dot">{{item.selected ? '✓' : ''}}</view>
        </view>
        <image
          wx:if="{{item.imageUrl}}"
          class="case-image"
          src="{{item.imageUrl}}"
          mode="aspectFill"
          lazy-load
        ></image>
        <view wx:else class="case-placeholder">暂无图片</view>
        <view class="case-title">{{item.title}}</view>
        <view class="case-tags">{{item.tagSummary}}</view>
      </view>
    </view>

    <view wx:if="{{manageMode}}" class="bottom-manage-bar">
      <view
        class="cancel-selected-button {{selectedCount ? '' : 'cancel-selected-button-disabled'}}"
        bindtap="cancelSelectedFavorites"
      >
        删除收藏
      </view>
    </view>
  </view>
</view>
