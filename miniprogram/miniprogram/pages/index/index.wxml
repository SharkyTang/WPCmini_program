<view class="page">
  <view class="hero">
    <view class="brand-title">金亿城包装科技</view>
    <view class="brand-subtitle">酒包装设计与定制灵感库</view>
  </view>

  <swiper
    wx:if="{{banners.length}}"
    class="banner-swiper"
    autoplay
    circular
    interval="3600"
    duration="450"
    previous-margin="24rpx"
    next-margin="24rpx"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-card" bindtap="onBannerTap" data-id="{{item.caseId}}">
        <image class="banner-image" mode="aspectFill" src="{{item.imageUrl}}"></image>
        <view class="banner-title" wx:if="{{item.title}}">{{item.title}}</view>
      </view>
    </swiper-item>
  </swiper>

  <view class="content">
    <view class="story-card">
      <view class="story-title">品牌故事</view>
      <view class="story-text">
        专注白酒包装设计与定制生产，把瓶标、酒盒、手提袋与外箱整合成完整品牌呈现。这里先沉淀企业介绍、服务优势和案例方向。
      </view>
    </view>

    <view wx:if="{{loading}}" class="state-box">正在读取案例...</view>
    <view wx:elif="{{errorMessage}}" class="state-box state-error">{{errorMessage}}</view>
    <block wx:else>
      <view class="section">
        <view class="section-head">
          <view class="section-title">热门产品</view>
          <view class="section-tip">精选案例</view>
        </view>
        <view wx:if="{{popularCases.length}}" class="product-grid">
          <view
            wx:for="{{popularCases}}"
            wx:key="id"
            class="product-card"
            bindtap="navigateToCase"
            data-id="{{item.id}}"
          >
            <image
              wx:if="{{item.coverImageUrl}}"
              class="product-image"
              mode="aspectFill"
              src="{{item.coverImageUrl}}"
            ></image>
            <view wx:else class="product-placeholder">暂无图片</view>
            <view class="product-title">{{item.title}}</view>
            <view class="product-meta">{{item.tagSummary}}</view>
          </view>
        </view>
        <view wx:else class="state-box">暂无热门产品</view>
      </view>

      <view class="section">
        <view class="section-head">
          <view class="section-title">最新产品</view>
          <view class="section-tip">近期更新</view>
        </view>
        <view wx:if="{{latestCases.length}}" class="product-grid">
          <view
            wx:for="{{latestCases}}"
            wx:key="id"
            class="product-card"
            bindtap="navigateToCase"
            data-id="{{item.id}}"
          >
            <image
              wx:if="{{item.coverImageUrl}}"
              class="product-image"
              mode="aspectFill"
              src="{{item.coverImageUrl}}"
            ></image>
            <view wx:else class="product-placeholder">暂无图片</view>
            <view class="product-title">{{item.title}}</view>
            <view class="product-meta">{{item.tagSummary}}</view>
          </view>
        </view>
        <view wx:else class="state-box">暂无最新产品</view>
      </view>
    </block>
  </view>
</view>
