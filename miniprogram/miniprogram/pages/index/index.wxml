<view class="page">
  <view class="hero">
    <view class="brand-title">金亿诚包装科技</view>
    <view class="brand-subtitle">酒包装设计与定制灵感库</view>
  </view>

  <swiper
    wx:if="{{banners.length}}"
    class="banner-swiper"
    autoplay
    circular
    interval="3600"
    duration="450"
    previous-margin="188rpx"
    next-margin="188rpx"
    bindchange="onBannerChange"
  >
    <swiper-item wx:for="{{banners}}" wx:for-index="bannerIndex" wx:key="id">
      <view
        class="banner-card {{bannerIndex == activeBannerIndex ? 'banner-card-active' : 'banner-card-preview'}}"
        bindtap="onBannerTap"
        data-id="{{item.caseId}}"
      >
        <image
          class="banner-image"
          mode="aspectFill"
          src="{{item.imageUrl}}"
          lazy-load
        ></image>
        <view
          class="banner-title"
          wx:if="{{item.title && bannerIndex == activeBannerIndex}}"
        >{{item.title}}</view>
      </view>
    </swiper-item>
  </swiper>

  <view class="content">
    <view class="story-card">
      <view class="story-mark">JYC PACKAGING</view>
      <view class="story-body">
        <view class="story-title">品牌故事</view>
        <view class="story-text">
          金亿诚包装科技专注酒类包装设计与定制生产，提供瓶标、酒瓶、酒盒、手提袋、外箱等一体化包装方案。通过真实案例展示，帮助客户快速寻找适合产品定位、价格带和使用场景的包装灵感。
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="state-box">正在读取案例...</view>
    <view wx:elif="{{errorMessage}}" class="state-box state-error">{{errorMessage}}</view>
    <block wx:else>
      <view class="section">
        <view class="section-head">
          <view class="section-title-group">
            <view class="section-title">热门产品</view>
            <view class="section-tip">精选案例</view>
          </view>
          <view class="section-more" bindtap="navigateToCategory" data-sort="popular">
            查看更多 >
          </view>
        </view>
        <view wx:if="{{popularCases.length}}" class="product-grid">
          <view
            wx:for="{{popularCases}}"
            wx:key="id"
            class="product-card"
            bindtap="navigateToCase"
            data-id="{{item.id}}"
          >
            <image
              wx:if="{{item.coverImageUrl}}"
              class="product-image"
              mode="aspectFill"
              src="{{item.coverImageUrl}}"
              lazy-load
            ></image>
            <view wx:else class="product-placeholder">暂无图片</view>
            <view class="product-badge">{{item.homeBadge}}</view>
            <view class="product-title">{{item.title}}</view>
            <view class="product-meta">{{item.tagSummary}}</view>
          </view>
        </view>
        <view wx:else class="state-box">暂无热门产品</view>
      </view>

      <view class="section">
        <view class="section-head">
          <view class="section-title-group">
            <view class="section-title">最新产品</view>
            <view class="section-tip">近期更新</view>
          </view>
          <view class="section-more" bindtap="navigateToCategory" data-sort="latest">
            查看更多 >
          </view>
        </view>
        <view wx:if="{{latestCases.length}}" class="product-grid">
          <view
            wx:for="{{latestCases}}"
            wx:key="id"
            class="product-card"
            bindtap="navigateToCase"
            data-id="{{item.id}}"
          >
            <image
              wx:if="{{item.coverImageUrl}}"
              class="product-image"
              mode="aspectFill"
              src="{{item.coverImageUrl}}"
              lazy-load
            ></image>
            <view wx:else class="product-placeholder">暂无图片</view>
            <view class="product-badge product-badge-latest">{{item.homeBadge}}</view>
            <view class="product-title">{{item.title}}</view>
            <view class="product-meta">{{item.tagSummary}}</view>
          </view>
        </view>
        <view wx:else class="state-box">暂无最新产品</view>
      </view>
    </block>
  </view>
</view>
