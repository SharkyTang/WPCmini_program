page {
  min-height: 100%;
  background: #f5efe4;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fff8ef 0%, rgba(255, 248, 239, 0) 340rpx),
    #f5efe4;
  padding-bottom: 64rpx;
  box-sizing: border-box;
}

.hero {
  padding: 58rpx 44rpx 24rpx;
}

.brand-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
  color: #211812;
}

.brand-subtitle {
  margin-top: 10rpx;
  color: #7d7166;
  font-size: 25rpx;
  line-height: 1.45;
}

.banner-swiper {
  height: 382rpx;
  margin: 18rpx 0 42rpx;
}

.banner-card {
  position: relative;
  height: 360rpx;
  margin: 0 8rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #f5e2ae;
  box-shadow: 0 14rpx 34rpx rgba(72, 49, 25, 0.14);
  transition: opacity 180ms ease;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-placeholder {
  background: linear-gradient(135deg, #f5e2ae 0%, #ead1a1 100%);
}

.image-retry-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
  color: #806b52;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.banner-card-preview {
  opacity: 0.72;
}

.banner-card-active {
  opacity: 1;
}

.banner-title {
  position: absolute;
  z-index: 1;
  left: 18rpx;
  bottom: 16rpx;
  max-width: 82%;
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(36, 29, 22, 0.76);
  color: #fff;
  font-size: 22rpx;
  line-height: 1.35;
}

.content {
  padding: 26rpx 40rpx 0;
  background: #fffdf8;
}

.story-card {
  padding: 12rpx 0 10rpx;
  display: grid;
  grid-template-columns: 124rpx minmax(0, 1fr);
  gap: 24rpx;
}

.story-mark {
  min-height: 174rpx;
  padding: 18rpx 14rpx;
  border-left: 8rpx solid #b77a2d;
  background: #2a2119;
  color: #f3ddbb;
  font-size: 19rpx;
  line-height: 1.45;
  font-weight: 800;
  writing-mode: vertical-rl;
  box-sizing: border-box;
}

.story-body {
  padding: 6rpx 0;
}

.story-title,
.section-title {
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border-radius: 4rpx;
  background: #b77a2d;
  vertical-align: -3rpx;
}

.story-text {
  margin-top: 14rpx;
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.65;
}

.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.section-title-group {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}

.section-tip {
  color: #8c8176;
  font-size: 22rpx;
  line-height: 1.4;
}

.section-more {
  flex: none;
  color: #9a6125;
  font-size: 22rpx;
  line-height: 1.4;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.product-card {
  min-width: 0;
  position: relative;
  padding: 12rpx;
  border: 2rpx solid rgba(234, 220, 202, 0.9);
  border-radius: 8rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 24rpx rgba(72, 49, 25, 0.08);
  box-sizing: border-box;
}

.product-badge {
  position: absolute;
  pointer-events: none;
  top: 22rpx;
  left: 22rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 6rpx;
  background: rgba(40, 95, 66, 0.92);
  color: #fff;
  display: flex;
  align-items: center;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 800;
}

.product-badge-latest {
  background: rgba(183, 122, 45, 0.94);
}

.product-image,
.product-placeholder {
  width: 100%;
  height: 214rpx;
  border-radius: 6rpx;
  background: linear-gradient(135deg, #f5e2ae 0%, #ead1a1 100%);
}

.product-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9d8d78;
  font-size: 23rpx;
}

.product-title {
  margin-top: 14rpx;
  color: #241d16;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-meta {
  min-height: 34rpx;
  margin-top: 6rpx;
  color: #8a6b45;
  font-size: 21rpx;
  line-height: 1.45;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.home-end-note {
  margin-top: 48rpx;
  padding: 34rpx 24rpx 8rpx;
  border-top: 2rpx solid #eadcca;
  text-align: center;
}

.home-end-note-active {
  background: rgba(154, 97, 37, 0.06);
  opacity: 0.78;
}

.home-end-title {
  color: #8c8176;
  font-size: 23rpx;
  line-height: 1.5;
}

.home-end-link {
  margin-top: 8rpx;
  color: #9a6125;
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 700;
}

.state-box {
  margin-top: 24rpx;
  padding: 48rpx 24rpx;
  border: 2rpx dashed #dfcfb7;
  border-radius: 8rpx;
  color: #8c8176;
  font-size: 26rpx;
  text-align: center;
}

.state-error {
  color: #9d2b22;
  background: #fff5f2;
  border-color: #efc3ba;
}

.state-preview {
  color: #8a5a22;
  background: #fff8ed;
  border-color: #efd2a8;
}

.state-retry {
  width: fit-content;
  margin: 24rpx auto 0;
  padding: 14rpx 28rpx;
  border: 2rpx solid currentColor;
  border-radius: 8rpx;
  color: #9d2b22;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}
