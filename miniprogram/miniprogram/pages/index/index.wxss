page {
  min-height: 100%;
  background: #f7f3ec;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding-bottom: 56rpx;
}

.hero {
  padding: 56rpx 48rpx 24rpx;
  background: #f7f3ec;
}

.hero-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-subtitle {
  margin-top: 8rpx;
  color: #7f7468;
  font-size: 24rpx;
  line-height: 1.45;
}

.banner-swiper {
  height: 230rpx;
  margin-bottom: 18rpx;
}

.banner-card {
  position: relative;
  height: 210rpx;
  margin: 0 14rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #f5e2ae;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-title {
  position: absolute;
  left: 18rpx;
  bottom: 16rpx;
  max-width: 82%;
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(36, 29, 22, 0.78);
  color: #fff;
  font-size: 22rpx;
  line-height: 1.35;
}

.content {
  padding: 28rpx 40rpx 0;
  background: #fffdf9;
}

.search-box {
  height: 76rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 38rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.search-input {
  width: 100%;
  height: 72rpx;
  color: #241d16;
  font-size: 26rpx;
}

.search-placeholder {
  color: #b9ab9c;
}

.selected-panel {
  margin-top: 26rpx;
  padding: 22rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fff;
}

.selected-head,
.section-head,
.result-head {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}

.selected-head {
  justify-content: space-between;
  font-size: 24rpx;
  font-weight: 700;
}

.clear-action {
  color: #b57a2a;
  font-size: 24rpx;
}

.selected-list,
.option-list,
.case-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.selected-list {
  margin-top: 18rpx;
}

.selected-pill,
.option-pill,
.case-tag {
  max-width: 100%;
  box-sizing: border-box;
  border-radius: 999rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.selected-pill {
  padding: 12rpx 20rpx;
  background: #241d16;
  color: #fff;
  font-size: 24rpx;
}

.section-head {
  margin-top: 34rpx;
}

.result-head {
  margin-top: 42rpx;
}

.section-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.section-tip {
  color: #8c8176;
  font-size: 22rpx;
  line-height: 1.4;
}

.filter-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.filter-card {
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fff;
  overflow: hidden;
}

.filter-header {
  min-height: 78rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-title {
  font-size: 28rpx;
  font-weight: 800;
}

.filter-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #a97835;
  font-size: 23rpx;
}

.filter-arrow {
  min-width: 22rpx;
  color: #6d6257;
  font-size: 30rpx;
  text-align: center;
}

.option-list {
  padding: 0 24rpx 24rpx;
}

.option-pill {
  padding: 14rpx 26rpx;
  border: 2rpx solid #dfcfb7;
  background: #fff;
  color: #6d6257;
  font-size: 24rpx;
}

.option-pill-active {
  border-color: #241d16;
  background: #241d16;
  color: #fff;
}

.state-box {
  margin-top: 24rpx;
  padding: 48rpx 24rpx;
  border: 2rpx dashed #dfcfb7;
  border-radius: 8rpx;
  color: #8c8176;
  font-size: 26rpx;
  text-align: center;
}

.state-error {
  color: #9d2b22;
  background: #fff5f2;
  border-color: #efc3ba;
}

.case-grid {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.case-card {
  min-width: 0;
}

.case-image,
.case-placeholder {
  width: 100%;
  height: 230rpx;
  border-radius: 8rpx;
  background: #f5e2ae;
}

.case-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9d8d78;
  font-size: 24rpx;
}

.case-title {
  margin-top: 14rpx;
  color: #241d16;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.case-tags {
  margin-top: 10rpx;
  gap: 8rpx;
}

.case-tag {
  padding: 7rpx 12rpx;
  border: 2rpx solid #eadcca;
  color: #8a6b45;
  font-size: 20rpx;
}

.load-more-tip {
  padding: 30rpx 0 10rpx;
  color: #8c8176;
  font-size: 24rpx;
  text-align: center;
}
