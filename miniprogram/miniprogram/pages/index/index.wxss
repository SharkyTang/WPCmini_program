page {
  min-height: 100%;
  background: #f7f3ec;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding-bottom: 64rpx;
  box-sizing: border-box;
}

.hero {
  padding: 58rpx 44rpx 24rpx;
}

.brand-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.brand-subtitle {
  margin-top: 10rpx;
  color: #7d7166;
  font-size: 25rpx;
  line-height: 1.45;
}

.banner-swiper {
  height: 326rpx;
  margin: 18rpx 0 42rpx;
}

.banner-card {
  position: relative;
  height: 304rpx;
  margin: 0 8rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #f5e2ae;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.banner-title {
  position: absolute;
  left: 18rpx;
  bottom: 16rpx;
  max-width: 82%;
  padding: 8rpx 14rpx;
  border-radius: 6rpx;
  background: rgba(36, 29, 22, 0.76);
  color: #fff;
  font-size: 22rpx;
  line-height: 1.35;
}

.content {
  padding: 26rpx 40rpx 0;
  background: #fffdf9;
}

.story-card {
  padding: 28rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fff;
}

.story-title,
.section-title {
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.story-text {
  margin-top: 14rpx;
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.65;
}

.section {
  margin-top: 36rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.section-tip {
  color: #8c8176;
  font-size: 22rpx;
  line-height: 1.4;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.product-card {
  min-width: 0;
  padding: 10rpx;
  border: 2rpx solid #eadcca;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
}

.product-image,
.product-placeholder {
  width: 100%;
  height: 214rpx;
  border-radius: 6rpx;
  background: #f5e2ae;
}

.product-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9d8d78;
  font-size: 23rpx;
}

.product-title {
  margin-top: 14rpx;
  color: #241d16;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-meta {
  min-height: 34rpx;
  margin-top: 6rpx;
  color: #8a6b45;
  font-size: 21rpx;
  line-height: 1.45;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.state-box {
  margin-top: 24rpx;
  padding: 48rpx 24rpx;
  border: 2rpx dashed #dfcfb7;
  border-radius: 8rpx;
  color: #8c8176;
  font-size: 26rpx;
  text-align: center;
}

.state-error {
  color: #9d2b22;
  background: #fff5f2;
  border-color: #efc3ba;
}
