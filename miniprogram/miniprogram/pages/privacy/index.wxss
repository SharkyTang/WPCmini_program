page {
  min-height: 100%;
  background: #f5efe4;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 58rpx 40rpx 104rpx;
  box-sizing: border-box;
  background:
    linear-gradient(180deg, #fff8ef 0%, rgba(255, 248, 239, 0) 340rpx),
    #f5efe4;
}

.hero {
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.page-subtitle,
.data-copy,
.action-copy,
.deletion-copy,
.footer-note {
  color: #766b60;
  font-size: 23rpx;
  line-height: 1.65;
}

.page-subtitle {
  margin-top: 10rpx;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(223, 207, 183, 0.86);
  border-radius: 12rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 24rpx rgba(72, 49, 25, 0.07);
}

.section-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.data-list,
.action-list {
  margin-top: 18rpx;
}

.data-row,
.action-row {
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(227, 210, 187, 0.72);
}

.data-row:last-child,
.action-row:last-child {
  border-bottom: none;
}

.data-name,
.action-title {
  color: #241d16;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 700;
}

.data-copy,
.action-copy {
  margin-top: 6rpx;
}

.action-row {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.action-row:active {
  opacity: 0.76;
}

.action-arrow {
  color: #8c8176;
  font-size: 42rpx;
  line-height: 1;
}

.deletion-copy {
  margin-top: 16rpx;
}

.contact-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  margin-top: 22rpx;
  padding: 0;
  border-radius: 39rpx;
  background: linear-gradient(135deg, #241d16 0%, #4a3520 100%);
  color: #fff;
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
}

.contact-button::after {
  border: none;
}

.footer-note {
  padding: 24rpx 12rpx 0;
  text-align: center;
  font-size: 21rpx;
}
