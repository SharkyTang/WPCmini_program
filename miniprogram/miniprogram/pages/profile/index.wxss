page {
  min-height: 100%;
  background: #f5efe4;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fff8ef 0%, rgba(255, 248, 239, 0) 340rpx),
    #f5efe4;
  padding: 58rpx 40rpx 104rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.user-card,
.section,
.quick-item,
.flow-row,
.faq-row {
  border: 2rpx solid rgba(223, 207, 183, 0.86);
  border-radius: 8rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 24rpx rgba(72, 49, 25, 0.07);
  box-sizing: border-box;
}

.user-card {
  min-height: 142rpx;
  padding: 28rpx;
  background:
    linear-gradient(135deg, rgba(183, 122, 45, 0.12), rgba(40, 95, 66, 0.08)),
    #fffdf8;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-card:active {
  opacity: 0.86;
}

.avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 43rpx;
  border: 2rpx solid #e3d2bb;
  background: #f6ead8;
  position: relative;
  overflow: hidden;
  flex: 0 0 86rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-head {
  position: absolute;
  left: 28rpx;
  top: 20rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 15rpx;
  background: #97938b;
}

.avatar-body {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  width: 46rpx;
  height: 28rpx;
  border-radius: 24rpx 24rpx 14rpx 14rpx;
  background: #97938b;
}

.user-copy {
  min-width: 0;
  flex: 1;
}

.user-arrow {
  color: #8c8176;
  font-size: 42rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.user-name {
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
}

.user-note {
  margin-top: 6rpx;
  color: #766b60;
  font-size: 23rpx;
  line-height: 1.45;
}

.section {
  margin-top: 30rpx;
  padding: 26rpx;
  background: #fffdf8;
}

.quick-section {
  padding: 30rpx 26rpx 32rpx;
}

.section-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border-radius: 4rpx;
  background: #b77a2d;
  vertical-align: -3rpx;
}

.quick-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 14rpx;
  row-gap: 18rpx;
}

.quick-item {
  min-width: 0;
  min-height: 128rpx;
  padding: 16rpx 8rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fffaf2;
  position: relative;
}

.quick-badge {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 7rpx;
  border-radius: 16rpx;
  background: #c0392b;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.quick-contact-shell {
  position: relative;
  overflow: hidden;
}

.quick-contact-button {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: inherit;
  box-sizing: border-box;
  line-height: normal;
  z-index: 2;
}

.quick-contact-button::after {
  border: none;
}

.quick-icon-image {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
}

.quick-title {
  margin-top: 12rpx;
  max-width: 100%;
  color: #241d16;
  font-size: 20rpx;
  line-height: 1.25;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.flow-list,
.faq-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.privacy-entry {
  min-height: 96rpx;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-top: 2rpx solid rgba(223, 207, 183, 0.72);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.privacy-entry:active {
  opacity: 0.76;
}

.privacy-entry-title {
  color: #241d16;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 700;
}

.privacy-entry-subtitle {
  margin-top: 4rpx;
  color: #766b60;
  font-size: 21rpx;
  line-height: 1.45;
}

.flow-row {
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.flow-number {
  width: 50rpx;
  height: 50rpx;
  border-radius: 25rpx;
  background: linear-gradient(135deg, #241d16 0%, #4a3520 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  flex: 0 0 50rpx;
}

.inquiry-entry {
  margin-top: 20rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #241d16 0%, #4a3520 100%);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(36, 29, 22, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.inquiry-admin-entry {
  margin-top: 16rpx;
  height: 76rpx;
  border: 2rpx solid #b77a2d;
  border-radius: 38rpx;
  color: #8f5d22;
  background: #fff8ef;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.badge-entry {
  position: relative;
}

.entry-badge {
  position: absolute;
  top: -12rpx;
  right: 26rpx;
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 9rpx;
  border: 4rpx solid #fff8ef;
  border-radius: 21rpx;
  background: #c0392b;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  line-height: 1;
  box-sizing: border-box;
}

.flow-copy,
.faq-copy {
  min-width: 0;
  flex: 1;
}

.flow-title,
.faq-title {
  color: #241d16;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
}

.flow-subtitle,
.faq-subtitle {
  margin-top: 4rpx;
  color: #8c8176;
  font-size: 21rpx;
  line-height: 1.4;
}

.faq-row {
  min-height: 88rpx;
  padding: 16rpx 18rpx 16rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.faq-arrow {
  color: #8c8176;
  font-size: 36rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.profile-load-tip {
  margin: 14rpx 4rpx -6rpx;
  color: #9d2b22;
  font-size: 21rpx;
  line-height: 1.45;
}
