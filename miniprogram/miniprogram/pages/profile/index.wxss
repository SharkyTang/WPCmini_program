page {
  min-height: 100%;
  background: #f7f3ec;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 58rpx 40rpx 104rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.user-card,
.section,
.quick-item,
.flow-row,
.faq-row {
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fffdf9;
  box-sizing: border-box;
}

.user-card {
  min-height: 142rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.user-card:active {
  opacity: 0.86;
}

.avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 43rpx;
  border: 2rpx solid #dfd8cf;
  background: #f2f0eb;
  position: relative;
  overflow: hidden;
  flex: 0 0 86rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-head {
  position: absolute;
  left: 28rpx;
  top: 20rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 15rpx;
  background: #97938b;
}

.avatar-body {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  width: 46rpx;
  height: 28rpx;
  border-radius: 24rpx 24rpx 14rpx 14rpx;
  background: #97938b;
}

.user-copy {
  min-width: 0;
  flex: 1;
}

.user-arrow {
  color: #8c8176;
  font-size: 42rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.user-name {
  color: #241d16;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 800;
}

.user-note {
  margin-top: 6rpx;
  color: #766b60;
  font-size: 23rpx;
  line-height: 1.45;
}

.section {
  margin-top: 30rpx;
  padding: 26rpx;
}

.quick-section {
  padding: 30rpx 26rpx 32rpx;
}

.section-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.quick-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 14rpx;
  row-gap: 18rpx;
}

.quick-item {
  min-width: 0;
  min-height: 128rpx;
  padding: 16rpx 8rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.quick-contact-shell {
  position: relative;
  overflow: hidden;
}

.quick-contact-button {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  color: inherit;
  box-sizing: border-box;
  line-height: normal;
  z-index: 2;
}

.quick-contact-button::after {
  border: none;
}

.quick-icon-image {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
}

.quick-title {
  margin-top: 12rpx;
  max-width: 100%;
  color: #241d16;
  font-size: 20rpx;
  line-height: 1.25;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.flow-list,
.faq-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.flow-row {
  min-height: 88rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.flow-number {
  width: 50rpx;
  height: 50rpx;
  border-radius: 25rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  flex: 0 0 50rpx;
}

.inquiry-entry {
  margin-top: 20rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.inquiry-admin-entry {
  margin-top: 16rpx;
  height: 76rpx;
  border: 2rpx solid #241d16;
  border-radius: 38rpx;
  color: #241d16;
  background: #fffdf9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
}

.flow-copy,
.faq-copy {
  min-width: 0;
  flex: 1;
}

.flow-title,
.faq-title {
  color: #241d16;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
}

.flow-subtitle,
.faq-subtitle {
  margin-top: 4rpx;
  color: #8c8176;
  font-size: 21rpx;
  line-height: 1.4;
}

.faq-row {
  min-height: 88rpx;
  padding: 16rpx 18rpx 16rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.faq-arrow {
  color: #8c8176;
  font-size: 36rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.profile-load-tip {
  margin: 14rpx 4rpx -6rpx;
  color: #9d2b22;
  font-size: 21rpx;
  line-height: 1.45;
}
