page {
  min-height: 100%;
  background: var(--brand-bg);
  color: var(--brand-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.profile-header {
  height: 310rpx;
  padding: 54rpx 40rpx 0;
  background:
    linear-gradient(140deg, rgba(183, 122, 45, 0.16), rgba(40, 95, 66, 0.08)),
    var(--brand-surface-strong);
  box-sizing: border-box;
}

.header-eyebrow {
  color: var(--brand-gold);
  font-size: 20rpx;
  line-height: 1.4;
  font-weight: 800;
}

.header-title {
  margin-top: 8rpx;
  color: var(--brand-ink);
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 800;
}

.header-subtitle {
  margin-top: 10rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.profile-card-shell {
  position: relative;
  margin: -76rpx 40rpx 0;
  padding-top: 86rpx;
}

.avatar-floating {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 2;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-card {
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
  box-sizing: border-box;
}

.profile-card {
  min-height: 350rpx;
  overflow: hidden;
}

.avatar-button {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  flex: 0 0 180rpx;
  min-width: 0;
  min-height: 0;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  box-shadow: none;
  overflow: visible;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.avatar-button::after {
  border: 0;
}

.avatar-image,
.avatar-placeholder {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  display: block;
  overflow: hidden;
  flex: 0 0 170rpx;
  border: 6rpx solid var(--brand-surface);
  box-shadow: 0 12rpx 28rpx rgba(72, 49, 25, 0.18);
  box-sizing: border-box;
}

.avatar-placeholder {
  position: relative;
  background: #f2f0eb;
}

.avatar-head {
  position: absolute;
  left: 58rpx;
  top: 37rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: #97938b;
}

.avatar-body {
  position: absolute;
  left: 40rpx;
  bottom: 30rpx;
  width: 88rpx;
  height: 54rpx;
  border-radius: 44rpx 44rpx 24rpx 24rpx;
  background: #97938b;
}

.avatar-edit-badge {
  position: absolute;
  right: -12rpx;
  bottom: -7rpx;
  min-width: 60rpx;
  height: 42rpx;
  padding: 0 10rpx;
  border: 4rpx solid #fff;
  border-radius: 24rpx;
  background: var(--brand-green);
  color: #fff;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 42rpx;
  text-align: center;
  box-sizing: border-box;
}

.avatar-space {
  height: 94rpx;
}

.profile-row {
  min-height: 152rpx;
  padding: 20rpx 38rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-top: 2rpx solid rgba(227, 210, 187, 0.58);
  box-sizing: border-box;
}

.profile-row-nickname {
  display: grid;
  grid-template-columns: 100rpx minmax(0, 1fr);
  align-items: start;
}

.profile-label {
  color: #3e3934;
  font-size: 32rpx;
  font-weight: 700;
  flex: 0 0 100rpx;
}

.profile-row-nickname .profile-label {
  height: 80rpx;
  line-height: 80rpx;
}

.nickname-input {
  display: block;
  width: 100%;
  height: 80rpx;
  min-width: 0;
  padding: 0;
  border: 0;
  color: #241d16;
  background: transparent;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 80rpx;
  box-sizing: border-box;
}

.nickname-field {
  min-width: 0;
  flex: 1;
}

.nickname-count {
  margin-top: -8rpx;
  color: #a3978a;
  font-size: 20rpx;
  line-height: 1.3;
  text-align: right;
}

.nickname-placeholder {
  color: #b3a89b;
  font-weight: 400;
}

.save-button {
  position: fixed;
  right: 40rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 40rpx;
  height: 88rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-ink);
  color: #fff;
  font-size: 27rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(36, 29, 22, 0.18);
}

.save-button:active,
.avatar-button:active {
  opacity: 0.82;
}

.save-button-disabled {
  background: #8c8176;
}

.profile-tip {
  padding: 0 38rpx 30rpx;
  color: var(--brand-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.sync-banner {
  min-height: 66rpx;
  margin: 0 30rpx 28rpx;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  background: rgba(40, 95, 66, 0.08);
  color: var(--brand-green);
  font-size: 21rpx;
  line-height: 1.45;
}

.sync-status-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 12rpx;
  border-radius: 50%;
  background: var(--brand-green);
}

.sync-banner-error {
  justify-content: space-between;
  background: rgba(181, 66, 54, 0.08);
  color: #9b3b31;
}

.sync-copy {
  min-width: 0;
  flex: 1;
}

.sync-retry {
  flex: 0 0 auto;
  color: #7f2c24;
  font-weight: 800;
  text-decoration: underline;
}
