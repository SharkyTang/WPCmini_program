<view class="page">
  <view class="hero">
    <view class="page-title">个人中心</view>
    <view class="page-subtitle">收藏案例、查看需求、联系顾问</view>
  </view>

  <view class="user-card" bindtap="openProfileEditor">
    <view class="avatar">
      <image wx:if="{{profileInfo.avatarUrl}}" class="avatar-image" src="{{profileInfo.avatarUrl}}" mode="aspectFill" />
      <block wx:else>
        <view class="avatar-head"></view>
        <view class="avatar-body"></view>
      </block>
    </view>
    <view class="user-copy">
      <view class="user-name">{{profileInfo.nickname}}</view>
      <view class="user-note">{{profileInfo.note}}</view>
    </view>
  </view>

  <view class="section quick-section">
    <view class="section-title">常用功能</view>
    <view class="quick-grid">
      <block wx:for="{{quickActions}}" wx:key="key">
        <view
          wx:if="{{item.key === 'service'}}"
          class="quick-item quick-contact-shell"
        >
          <image class="quick-icon-image" src="{{item.iconSrc}}" mode="aspectFit" />
          <view class="quick-title">{{item.title}}</view>
          <button
            class="quick-contact-button"
            open-type="contact"
            session-from="{{customerServiceSessionFrom}}"
            bindcontact="handleContact"
          ></button>
        </view>
        <view
          wx:else
          class="quick-item"
          data-key="{{item.key}}"
          bindtap="handleQuickAction"
        >
          <image class="quick-icon-image" src="{{item.iconSrc}}" mode="aspectFit" />
          <view class="quick-title">{{item.title}}</view>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section-title">定制流程</view>
    <view class="flow-list">
      <view wx:for="{{flowSteps}}" wx:key="step" class="flow-row">
        <view class="flow-number">{{item.step}}</view>
        <view class="flow-copy">
          <view class="flow-title">{{item.title}}</view>
          <view class="flow-subtitle">{{item.subtitle}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">常见问题</view>
    <view class="faq-list">
      <view wx:for="{{faqItems}}" wx:key="key" class="faq-row">
        <view class="faq-copy">
          <view class="faq-title">{{item.title}}</view>
          <view class="faq-subtitle">{{item.subtitle}}</view>
        </view>
        <view class="faq-arrow">›</view>
      </view>
    </view>
  </view>

  <view wx:if="{{isProfileEditorVisible}}" class="profile-editor-mask" catchtap="closeProfileEditor">
    <view class="profile-editor-sheet" catchtap="noop">
      <view class="profile-option-list">
        <view class="profile-option-row profile-option-preview">
          <view class="profile-option-title">用微信头像</view>
          <image wx:if="{{profileDraft.avatarUrl}}" class="profile-option-avatar" src="{{profileDraft.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="profile-option-avatar profile-option-avatar-empty">
            <view class="avatar-head"></view>
            <view class="avatar-body"></view>
          </view>
        </view>

        <view class="profile-option-row profile-option-preview">
          <view class="profile-option-title">用微信名称</view>
          <view class="profile-option-name">{{profileDraft.nickname}}</view>
        </view>

        <view class="profile-option-row profile-option-action" bindtap="chooseProfileAvatarFromAlbum">从相册选择</view>
        <view class="profile-option-row profile-option-action" bindtap="takeProfileAvatarPhoto">拍照</view>
      </view>

      <view class="profile-cancel-button" bindtap="closeProfileEditor">取消</view>
    </view>
  </view>
</view>
