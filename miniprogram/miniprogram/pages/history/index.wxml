<view class="page">
  <view class="hero">
    <view>
      <view class="page-title">浏览记录</view>
      <view class="page-subtitle">这里保存你最近看过的酒包装案例</view>
    </view>
    <view
      wx:if="{{accessState === 'ready' && historyCards.length}}"
      class="manage-button"
      bindtap="toggleManageMode"
    >
      {{manageMode ? '完成' : '管理'}}
    </view>
  </view>

  <view wx:if="{{accessState === 'profile_required'}}" class="state-shell">
    <mp-msg type="info" title="完善个人资料" desc="完善资料后可安全保存并跨设备查看浏览记录" />
    <view class="state-button" bindtap="requestProfileAccess">去完善资料</view>
  </view>

  <view wx:elif="{{accessState === 'checking' || loading}}" class="state-shell">
    <mp-msg type="waiting" title="正在读取浏览记录" desc="正在整理你最近看过的案例" />
  </view>

  <view wx:elif="{{accessState === 'error'}}" class="state-shell state-error">
    <mp-msg type="warn" title="浏览记录读取失败" desc="{{errorMessage}}" />
    <view class="state-button" bindtap="ensureProfileAndLoad">重新验证</view>
  </view>

  <view wx:elif="{{accessState === 'ready' && !historyCards.length}}" class="state-shell">
    <mp-msg type="info" title="还没有浏览记录" desc="进入案例详情页后，浏览过的案例会出现在这里" />
    <view class="state-button" bindtap="goToCategory">去看案例</view>
  </view>

  <view wx:else>
    <view wx:if="{{manageMode}}" class="manage-toolbar">
      <view class="manage-count">已选择 {{selectedCount}} 条</view>
      <view class="manage-actions">
        <view class="manage-action" bindtap="toggleSelectAll">
          {{selectedCount === historyCards.length ? '取消全选' : '全选'}}
        </view>
        <view class="manage-action manage-action-danger" bindtap="clearAllHistory">清空全部</view>
      </view>
    </view>

    <view class="history-grid {{manageMode ? 'history-grid-manage' : ''}}">
    <view
      wx:for="{{historyCards}}"
      wx:key="historyId"
      class="case-card {{manageMode ? 'case-card-manage' : ''}} {{item.selected ? 'case-card-selected' : ''}}"
      data-id="{{item.id}}"
      data-history-id="{{item.historyId}}"
      bindtap="handleCardTap"
    >
      <view wx:if="{{manageMode}}" class="select-mark">
        <view class="select-dot">{{item.selected ? '✓' : ''}}</view>
      </view>
      <image
        wx:if="{{item.imageUrl}}"
        class="case-image"
        src="{{item.imageUrl}}"
        mode="aspectFill"
        lazy-load
      ></image>
      <view wx:else class="case-placeholder">暂无图片</view>
      <view class="case-title">{{item.title}}</view>
      <view class="case-tags">{{item.tagSummary}}</view>
    </view>
    </view>

    <view wx:if="{{manageMode}}" class="bottom-manage-bar">
      <view
        class="delete-selected-button {{selectedCount ? '' : 'delete-selected-button-disabled'}}"
        bindtap="deleteSelectedHistory"
      >
        删除选中
      </view>
    </view>
  </view>

  <mp-dialog
    ext-class="brand-dialog"
    show="{{confirmDialog.show}}"
    title="{{confirmDialog.title}}"
    buttons="{{confirmDialog.buttons}}"
    bindbuttontap="handleConfirmDialogTap"
    bindclose="closeConfirmDialog"
  >
    <view class="dialog-content">{{confirmDialog.content}}</view>
  </mp-dialog>
</view>
