page {
  min-height: 100%;
  background: #f5efe4;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  background:
    linear-gradient(180deg, #fff8ef 0%, rgba(255, 248, 239, 0) 320rpx),
    #f5efe4;
  padding: 58rpx 40rpx 104rpx;
  box-sizing: border-box;
}

.hero {
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.form-card {
  padding: 30rpx 28rpx;
  border: 2rpx solid rgba(223, 207, 183, 0.86);
  border-radius: 8rpx;
  background: linear-gradient(180deg, #fffdf8 0%, #fff8ef 100%);
  box-shadow: 0 12rpx 30rpx rgba(72, 49, 25, 0.08);
  box-sizing: border-box;
}

.form-section-title {
  margin: 4rpx 0 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #b77a2d;
  color: #241d16;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 900;
}

.field + .form-section-title {
  margin-top: 40rpx;
}

.field + .field {
  margin-top: 34rpx;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.field-label {
  color: #241d16;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 800;
}

.field-count,
.field-tip {
  color: #9d8d78;
  font-size: 22rpx;
  line-height: 1.4;
}

.field-tip {
  margin-top: 12rpx;
}

.type-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.type-chip {
  min-width: 0;
  height: 64rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e0cfb8;
  border-radius: 32rpx;
  background: #fff;
  color: #8c6a3f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.type-chip-active {
  border-color: #b77a2d;
  background: #2a2119;
  color: #fffdf9;
}

.content-input,
.contact-input {
  width: 100%;
  margin-top: 18rpx;
  border: 2rpx solid #e0cfb8;
  border-radius: 8rpx;
  background: #fff;
  color: #241d16;
  font-size: 25rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.content-input {
  min-height: 260rpx;
  padding: 22rpx 24rpx;
}

.contact-input {
  height: 76rpx;
  padding: 0 24rpx;
}

.input-placeholder {
  color: #b0a493;
}

.submit-button {
  margin-top: 32rpx;
  height: 78rpx;
  border-radius: 39rpx;
  background: linear-gradient(135deg, #241d16 0%, #4a3520 100%);
  color: #fffdf9;
  box-shadow: 0 12rpx 28rpx rgba(36, 29, 22, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
}

.submit-button-disabled {
  background: #d8ccbd;
  box-shadow: none;
}
