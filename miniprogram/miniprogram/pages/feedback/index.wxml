<view class="page">
  <mp-toptips
    msg="{{topTips.message}}"
    type="{{topTips.type}}"
    show="{{topTips.show}}"
    bindhide="hideTopTips"
  />

  <view class="hero">
    <view class="page-title">意见反馈</view>
    <view class="page-subtitle">告诉我哪里不好用，或者你想增加什么功能</view>
  </view>

  <view class="form-card">
    <view class="form-section-title">反馈分类</view>
    <view class="field">
      <view class="field-label">反馈类型</view>
      <view class="type-grid">
        <view
          wx:for="{{feedbackTypes}}"
          wx:key="key"
          class="type-chip {{selectedType === item.key ? 'type-chip-active' : ''}}"
          data-type="{{item.key}}"
          bindtap="selectType"
        >
          {{item.label}}
        </view>
      </view>
    </view>

    <view class="form-section-title">反馈内容</view>
    <view class="field">
      <view class="field-heading">
        <view class="field-label">反馈内容</view>
        <view class="field-count">{{content.length}} / {{contentMaxLength}}</view>
      </view>
      <textarea
        class="content-input"
        value="{{content}}"
        maxlength="{{contentMaxLength}}"
        placeholder="请描述你遇到的问题、建议或想要的功能"
        placeholder-class="input-placeholder"
        bindinput="updateContent"
      />
    </view>

    <view class="form-section-title">联系信息</view>
    <view class="field">
      <view class="field-label">联系方式（选填）</view>
      <input
        class="contact-input"
        value="{{contact}}"
        maxlength="120"
        placeholder="微信号 / 手机号 / 邮箱"
        placeholder-class="input-placeholder"
        bindinput="updateContact"
      />
      <view class="field-tip">方便我需要进一步确认问题时联系你。</view>
    </view>
  </view>

  <view
    class="submit-button {{submitting ? 'submit-button-disabled' : ''}}"
    bindtap="submitForm"
  >
    {{submitting ? '提交中...' : '提交反馈'}}
  </view>
</view>
