page {
  min-height: 100%;
  background: #f5efe4;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.topbar {
  padding: 36rpx 38rpx 26rpx;
  background:
    linear-gradient(180deg, #fff8ef 0%, #fffdf8 100%);
  flex: 0 0 auto;
}

.search-box {
  height: 70rpx;
  border: 2rpx solid #e0cfb8;
  border-radius: 35rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(72, 49, 25, 0.06);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.search-icon {
  width: 34rpx;
  color: #8c8176;
  font-size: 26rpx;
  line-height: 1;
}

.search-input {
  flex: 1;
  height: 66rpx;
  color: #241d16;
  font-size: 25rpx;
}

.search-placeholder {
  color: #b9ab9c;
}

.main {
  display: flex;
  flex: 1;
  min-height: 0;
}

.side-nav {
  width: 150rpx;
  flex: 0 0 150rpx;
  padding: 28rpx 18rpx 48rpx;
  background: #eee5d9;
  box-sizing: border-box;
  overflow-y: auto;
}

.nav-item {
  min-height: 64rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #e2cfb4;
  border-radius: 32rpx;
  background: #fffaf2;
  color: #241d16;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}

.nav-group {
  margin-bottom: 10rpx;
}

.nav-item-active {
  border-color: rgba(183, 122, 45, 0.48);
  background: #fff8ef;
  color: #241d16;
  box-shadow: 0 8rpx 18rpx rgba(72, 49, 25, 0.08);
}

.nav-item-active::before {
  content: "";
  position: absolute;
  left: -12rpx;
  top: 16rpx;
  bottom: 16rpx;
  width: 7rpx;
  border-radius: 4rpx;
  background: #b77a2d;
}

.nav-title {
  max-width: 92rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
}

.nav-badge {
  position: absolute;
  right: 8rpx;
  top: -18rpx;
  min-width: 34rpx;
  height: 28rpx;
  padding: 0 9rpx;
  border-radius: 14rpx;
  background: #b9782a;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.sub-nav {
  margin: -4rpx 0 20rpx;
  padding: 0 0 8rpx;
}

.sub-nav-item {
  min-height: 48rpx;
  margin-bottom: 6rpx;
  padding: 8rpx 6rpx;
  border-radius: 8rpx;
  color: #7c8292;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  line-height: 1.25;
  text-align: center;
  word-break: keep-all;
}

.sub-nav-item-active {
  background: #2a2119;
  color: #fff;
  font-weight: 800;
}

.content {
  flex: 1;
  height: auto;
  background: #fffdf8;
}

.content-inner {
  padding: 34rpx 28rpx 64rpx;
  box-sizing: border-box;
}

.category-title-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx;
}

.category-title {
  color: #241d16;
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 800;
}

.category-subtitle {
  margin-top: 8rpx;
  color: #766b60;
  font-size: 23rpx;
  line-height: 1.45;
}

.category-package-note {
  font-size: 26rpx;
  line-height: 1.35;
}

.selected-panel {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(223, 207, 183, 0.86);
  border-radius: 8rpx;
  background: #fffaf2;
  box-shadow: 0 10rpx 24rpx rgba(72, 49, 25, 0.07);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.selected-list,
.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.selected-list {
  flex: 1;
}

.selected-pill,
.option-pill {
  max-width: 100%;
  box-sizing: border-box;
  border-radius: 999rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.selected-pill {
  padding: 10rpx 12rpx 10rpx 18rpx;
  background: #fff;
  border: 2rpx solid rgba(183, 122, 45, 0.58);
  color: #80531f;
  font-size: 22rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.selected-pill-remove {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #2a2119;
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 1;
}

.clear-action {
  color: #b57a2a;
  font-size: 23rpx;
  line-height: 1.6;
  white-space: nowrap;
}

.option-list {
  margin-top: 26rpx;
}

.option-pill {
  padding: 14rpx 24rpx;
  border: 2rpx solid #e0cfb8;
  background: #fff;
  color: #6d6257;
  font-size: 24rpx;
}

.option-pill-active {
  border-color: #b77a2d;
  background: #fff2dc;
  color: #80531f;
  box-shadow: inset 0 0 0 2rpx rgba(183, 122, 45, 0.16);
}

.result-count {
  margin-top: 28rpx;
  color: #8c8176;
  font-size: 22rpx;
  line-height: 1.4;
}

.case-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 26rpx 22rpx;
}

.case-card {
  min-width: 0;
  padding: 10rpx;
  border-radius: 8rpx;
  background: #fffdf8;
  box-shadow: 0 10rpx 22rpx rgba(72, 49, 25, 0.07);
}

.case-image,
.case-placeholder {
  width: 100%;
  height: 190rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #f5e2ae 0%, #ead1a1 100%);
}

.case-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9d8d78;
  font-size: 23rpx;
}

.case-title {
  margin-top: 12rpx;
  color: #241d16;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.case-meta {
  min-height: 32rpx;
  margin-top: 6rpx;
  color: #8a6b45;
  font-size: 20rpx;
  line-height: 1.45;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.load-more-status {
  padding: 34rpx 0 8rpx;
  color: #766b60;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.state-box {
  margin-top: 24rpx;
  padding: 44rpx 22rpx;
  border: 2rpx dashed #dfcfb7;
  border-radius: 8rpx;
  color: #8c8176;
  font-size: 24rpx;
  text-align: center;
}

.state-error {
  color: #9d2b22;
  background: #fff5f2;
  border-color: #efc3ba;
}

.state-retry-button {
  margin: 24rpx auto 0;
  width: 220rpx;
  height: 68rpx;
  border: 0;
  border-radius: 8rpx;
  background: var(--brand-green);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.state-retry-button::after {
  border: 0;
}
