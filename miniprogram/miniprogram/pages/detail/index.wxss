page {
  min-height: 100%;
  background: #f7f3ec;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 56rpx;
  box-sizing: border-box;
}

.detail {
  display: flex;
  flex-direction: column;
}

.hero-copy {
  margin-bottom: 30rpx;
}

.hero-image,
.hero-placeholder {
  width: 100%;
  height: 620rpx;
  border-radius: 8rpx;
  background: #f5e2ae;
}

.hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9d8d78;
  font-size: 26rpx;
}

.image-actions {
  margin-top: 22rpx;
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
}

.image-action {
  min-width: 150rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 700;
}

.image-action-secondary {
  border: 2rpx solid #dfcfb7;
  background: #fffdf9;
  color: #7a5a31;
}

.image-action-primary {
  background: #241d16;
  color: #fff;
}

.title-block {
  margin-top: 34rpx;
}

.case-title {
  color: #241d16;
  font-size: 42rpx;
  line-height: 1.22;
  font-weight: 800;
  letter-spacing: 0;
}

.case-subtitle {
  margin-top: 8rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.detail-heading {
  color: #241d16;
  font-size: 34rpx;
  line-height: 1.28;
  font-weight: 800;
  letter-spacing: 0;
}

.detail-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.tag-section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.tag-list {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  max-width: 100%;
  padding: 13rpx 22rpx;
  border-radius: 999rpx;
  background: #241d16;
  color: #fff;
  font-size: 23rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.info-card {
  margin-top: 34rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fffdf9;
}

.info-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 24rpx;
  padding: 11rpx 0;
}

.info-row-notes {
  padding-top: 22rpx;
  border-top: 2rpx solid #eadcca;
  margin-top: 12rpx;
}

.info-label {
  color: #6f6257;
  font-size: 25rpx;
  line-height: 1.5;
}

.info-value {
  color: #241d16;
  font-size: 25rpx;
  line-height: 1.5;
  word-break: break-all;
}

.consult-button {
  margin-top: 36rpx;
  height: 78rpx;
  border-radius: 39rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.back-button {
  margin-top: 20rpx;
  height: 76rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 38rpx;
  background: #fffdf9;
  color: #6f6257;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
}

.state-box {
  margin-top: 140rpx;
  padding: 58rpx 28rpx;
  border: 2rpx dashed #dfcfb7;
  border-radius: 8rpx;
  background: #fffdf9;
  color: #8c8176;
  font-size: 26rpx;
  text-align: center;
}

.state-error {
  color: #9d2b22;
  background: #fff5f2;
  border-color: #efc3ba;
}
