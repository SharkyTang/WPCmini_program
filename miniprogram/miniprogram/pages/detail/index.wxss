page {
  min-height: 100%;
  background: var(--brand-bg);
  color: var(--brand-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.detail {
  display: flex;
  flex-direction: column;
}

.detail-skeleton {
  min-height: 70vh;
}

.skeleton-hero,
.skeleton-line,
.skeleton-card {
  background: linear-gradient(
    90deg,
    rgba(235, 225, 209, 0.7) 0%,
    rgba(249, 245, 237, 0.95) 50%,
    rgba(235, 225, 209, 0.7) 100%
  );
  background-size: 200% 100%;
  animation: detail-skeleton-shimmer 1.2s ease-in-out infinite;
}

.skeleton-hero {
  width: 100%;
  aspect-ratio: 5 / 4;
  max-height: 560rpx;
  border-radius: 16rpx;
}

.skeleton-line {
  width: 100%;
  height: 24rpx;
  margin-top: 24rpx;
  border-radius: 6rpx;
}

.skeleton-line-title {
  width: 58%;
  height: 34rpx;
}

.skeleton-line-short {
  width: 72%;
}

.skeleton-card {
  margin-top: 30rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
}

@keyframes detail-skeleton-shimmer {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

.section-kicker {
  color: var(--brand-gold);
  font-size: 20rpx;
  line-height: 1.4;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-image-wrap,
.hero-placeholder {
  width: 100%;
  aspect-ratio: 5 / 4;
  max-height: 560rpx;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #f6e5bc 0%, #ead1a1 100%);
}

.hero-image-wrap {
  position: relative;
  overflow: hidden;
  box-shadow: 0 14rpx 34rpx rgba(72, 49, 25, 0.13);
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9b8f82;
  background: #f2eee8;
  font-size: 24rpx;
}

.hero-gallery {
  width: 100%;
  height: 100%;
}

.gallery-thumbnails {
  width: 100%;
  margin: 18rpx 0 0;
  white-space: nowrap;
}

.gallery-thumbnails-track {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 2rpx 6rpx;
  box-sizing: border-box;
}

.gallery-thumbnail {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  border-radius: 8rpx;
  box-sizing: border-box;
  opacity: 0.68;
}

.gallery-thumbnail-active {
  border-color: var(--brand-gold);
  box-shadow: 0 6rpx 14rpx rgba(183, 122, 45, 0.18);
  opacity: 1;
}

.gallery-thumbnail-image {
  width: 100%;
  height: 100%;
}

.gallery-thumbnail-empty {
  background: #eee9e2;
}

.hero-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--brand-muted);
}

.placeholder-title {
  color: var(--brand-ink);
  font-size: 28rpx;
  font-weight: 800;
}

.placeholder-copy {
  font-size: 23rpx;
}

.hero-favorite {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  min-width: 146rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.94);
  border: 2rpx solid rgba(227, 210, 187, 0.95);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--brand-ink);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-favorite-active {
  background: var(--brand-green-soft);
  border-color: rgba(40, 95, 66, 0.42);
  color: var(--brand-green);
}

.hero-favorite-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.hero-favorite-heart {
  height: 34rpx;
  color: var(--brand-green);
  font-size: 34rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.hero-favorite-label {
  line-height: 1;
}

.image-count {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  min-width: 76rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 24rpx;
  background: rgba(36, 29, 22, 0.76);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.image-preview-tip {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  min-width: 212rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(36, 29, 22, 0.78);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 21rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.image-preview-icon {
  display: block;
  flex: 0 0 auto;
}

.gallery-swipe-tip {
  padding-top: 8rpx;
  color: rgba(118, 107, 96, 0.78);
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.video-card {
  position: relative;
  width: 100%;
  height: 382rpx;
  margin-top: 26rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #2d2822;
  box-shadow: var(--brand-shadow);
}

.case-video,
.video-error-state {
  width: 100%;
  height: 382rpx;
  display: block;
}

.video-copy {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  padding: 24rpx 26rpx 44rpx;
  background: linear-gradient(180deg, rgba(25, 20, 16, 0.72), rgba(25, 20, 16, 0));
  color: #fff;
  pointer-events: none;
}

.video-title {
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
}

.video-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  line-height: 1.4;
}

.video-duration {
  position: absolute;
  right: 18rpx;
  bottom: 72rpx;
  height: 42rpx;
  padding: 0 12rpx;
  border-radius: 21rpx;
  background: rgba(25, 20, 16, 0.72);
  color: #fff;
  font-size: 18rpx;
  line-height: 42rpx;
  pointer-events: none;
}

.video-error-state {
  position: relative;
  overflow: hidden;
}

.video-error-poster,
.video-error-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.video-error-shade {
  background: rgba(36, 29, 22, 0.7);
}

.video-error-content {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #fff;
}

.video-error-title {
  font-size: 25rpx;
  font-weight: 700;
}

.video-retry {
  height: 58rpx;
  padding: 0 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 58rpx;
}

.section-title {
  margin-top: 5rpx;
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.info-card {
  margin-top: 26rpx;
  padding: 28rpx 30rpx;
  border-radius: 16rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
}

.info-card-head {
  margin-bottom: 10rpx;
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 20rpx;
  align-items: start;
}

.info-case-title {
  min-width: 0;
  text-align: left;
  white-space: normal;
  word-break: break-word;
}

.info-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(227, 210, 187, 0.58);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.info-value {
  color: var(--brand-ink);
  font-size: 25rpx;
  line-height: 1.5;
  font-weight: 700;
  word-break: break-word;
}

.cta-group {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.consult-button,
.inquiry-button {
  width: 100%;
  min-height: 100rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.inquiry-button {
  background: var(--brand-ink);
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(36, 29, 22, 0.16);
}

.cta-title {
  font-size: 27rpx;
}

.cta-copy {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  font-weight: 500;
}

.consult-button {
  border: 2rpx solid var(--brand-line);
  background: var(--brand-surface);
  color: var(--brand-green);
}

.consult-contact-button {
  margin: 0;
  padding: 0;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  align-self: stretch;
  line-height: normal;
}

.consult-contact-button::after {
  border: none;
}

.error-actions {
  margin-top: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.back-button,
.retry-button {
  width: 260rpx;
  height: 76rpx;
  border-radius: 8rpx;
  background: var(--brand-ink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
}

.retry-button {
  background: var(--brand-green);
}

.state-shell {
  min-height: 70vh;
  padding-top: 48rpx;
  text-align: center;
}

.state-shell-error {
  padding-top: 24rpx;
}
