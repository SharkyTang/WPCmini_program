page {
  min-height: 100%;
  background: #f7f3ec;
  color: #241d16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 56rpx;
  box-sizing: border-box;
}

.detail {
  display: flex;
  flex-direction: column;
}

.hero-copy {
  margin-bottom: 30rpx;
}

.hero-image-wrap,
.hero-placeholder {
  width: 100%;
  height: 620rpx;
  border-radius: 8rpx;
  background: #f5e2ae;
}

.hero-image-wrap {
  position: relative;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-gallery {
  width: 100%;
  height: 100%;
}

.gallery-thumbnails {
  display: flex;
  gap: 14rpx;
  margin: 20rpx 0 0;
  overflow-x: auto;
  white-space: nowrap;
}

.gallery-thumbnail {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.gallery-thumbnail-active {
  border-color: #241d16;
}

.gallery-thumbnail-image {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9d8d78;
  font-size: 26rpx;
}

.hero-favorite {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  min-width: 146rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 249, 0.94);
  border: 2rpx solid rgba(223, 207, 183, 0.95);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #241d16;
  font-size: 24rpx;
  font-weight: 800;
}

.hero-favorite-active {
  background: rgba(255, 253, 249, 0.96);
  border-color: rgba(36, 29, 22, 0.3);
}

.hero-favorite-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.hero-favorite-heart {
  height: 34rpx;
  color: #000;
  font-size: 34rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.hero-favorite-label {
  line-height: 1;
}

.title-block {
  margin-top: 34rpx;
}

.case-title {
  color: #241d16;
  font-size: 42rpx;
  line-height: 1.22;
  font-weight: 800;
  letter-spacing: 0;
}

.case-subtitle {
  margin-top: 8rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.detail-heading {
  color: #241d16;
  font-size: 34rpx;
  line-height: 1.28;
  font-weight: 800;
  letter-spacing: 0;
}

.detail-subtitle {
  margin-top: 10rpx;
  color: #766b60;
  font-size: 25rpx;
  line-height: 1.45;
}

.tag-section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
}

.tag-list {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  max-width: 100%;
  padding: 13rpx 22rpx;
  border-radius: 999rpx;
  background: #241d16;
  color: #fff;
  font-size: 23rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.info-card {
  margin-top: 34rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 8rpx;
  background: #fffdf9;
}

.info-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 24rpx;
  padding: 11rpx 0;
}

.info-row-notes {
  padding-top: 22rpx;
  border-top: 2rpx solid #eadcca;
  margin-top: 12rpx;
}

.info-label {
  color: #6f6257;
  font-size: 25rpx;
  line-height: 1.5;
}

.info-value {
  color: #241d16;
  font-size: 25rpx;
  line-height: 1.5;
  word-break: break-all;
}

.consult-button {
  margin-top: 20rpx;
  height: 78rpx;
  border-radius: 39rpx;
  background: #241d16;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.inquiry-button {
  margin-top: 36rpx;
  height: 78rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 39rpx;
  background: #fffdf9;
  color: #241d16;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.consult-contact-button {
  padding: 0;
  border: none;
  line-height: normal;
}

.consult-contact-button::after {
  border: none;
}

.back-button {
  margin-top: 20rpx;
  height: 76rpx;
  border: 2rpx solid #dfcfb7;
  border-radius: 38rpx;
  background: #fffdf9;
  color: #6f6257;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
}

.state-box {
  margin-top: 140rpx;
  padding: 58rpx 28rpx;
  border: 2rpx dashed #dfcfb7;
  border-radius: 8rpx;
  background: #fffdf9;
  color: #8c8176;
  font-size: 26rpx;
  text-align: center;
}

.state-error {
  color: #9d2b22;
  background: #fff5f2;
  border-color: #efc3ba;
}

.image-preview-layer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-preview-close {
  position: absolute;
  top: 48rpx;
  right: 34rpx;
  z-index: 2;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 300;
}

.image-preview-area {
  position: relative;
  z-index: 1;
  width: 100vw;
  height: 100vh;
}

.image-preview-movable {
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.image-preview-image {
  width: 100vw;
  height: 100vh;
}

.image-preview-download {
  position: absolute;
  right: 34rpx;
  bottom: 58rpx;
  z-index: 2;
  height: 76rpx;
  padding: 0 26rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.image-preview-download-icon {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
}
