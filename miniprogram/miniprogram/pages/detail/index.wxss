page {
  min-height: 100%;
  background: var(--brand-bg);
  color: var(--brand-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 42rpx 36rpx 64rpx;
  box-sizing: border-box;
}

.detail {
  display: flex;
  flex-direction: column;
}

.section-kicker {
  color: var(--brand-gold);
  font-size: 20rpx;
  line-height: 1.4;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-image-wrap,
.hero-placeholder {
  width: 100%;
  aspect-ratio: 1 / 1;
  max-height: 660rpx;
  border-radius: 8rpx;
  background: linear-gradient(145deg, #f6e5bc 0%, #ead1a1 100%);
}

.hero-image-wrap {
  position: relative;
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(72, 49, 25, 0.16);
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-gallery {
  width: 100%;
  height: 100%;
}

.gallery-thumbnails {
  width: 100%;
  margin: 22rpx 0 0;
  white-space: nowrap;
}

.gallery-thumbnails-track {
  display: inline-flex;
  gap: 14rpx;
  padding: 4rpx 2rpx 8rpx;
  box-sizing: border-box;
}

.gallery-thumbnail {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
  border-radius: 8rpx;
  box-sizing: border-box;
  opacity: 0.68;
}

.gallery-thumbnail-active {
  border-color: var(--brand-gold);
  box-shadow: 0 6rpx 14rpx rgba(183, 122, 45, 0.18);
  opacity: 1;
}

.gallery-thumbnail-image {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--brand-muted);
}

.placeholder-title {
  color: var(--brand-ink);
  font-size: 28rpx;
  font-weight: 800;
}

.placeholder-copy {
  font-size: 23rpx;
}

.hero-favorite {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  min-width: 146rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.94);
  border: 2rpx solid rgba(227, 210, 187, 0.95);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--brand-ink);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-favorite-active {
  background: var(--brand-green-soft);
  border-color: rgba(40, 95, 66, 0.42);
  color: var(--brand-green);
}

.hero-favorite-icon {
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
}

.hero-favorite-heart {
  height: 34rpx;
  color: var(--brand-green);
  font-size: 34rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.hero-favorite-label {
  line-height: 1;
}

.image-count {
  position: absolute;
  left: 20rpx;
  bottom: 20rpx;
  min-width: 76rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 24rpx;
  background: rgba(36, 29, 22, 0.76);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.section-title {
  margin-top: 5rpx;
  color: var(--brand-ink);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.info-card,
.notes-card {
  margin-top: 30rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: var(--brand-surface);
  box-shadow: var(--brand-shadow);
}

.info-card-head {
  margin-bottom: 8rpx;
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 24rpx;
  align-items: baseline;
}

.info-case-title {
  min-width: 0;
  overflow: hidden;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-row {
  display: grid;
  grid-template-columns: 150rpx minmax(0, 1fr);
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid rgba(227, 210, 187, 0.58);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.info-value {
  color: var(--brand-ink);
  font-size: 25rpx;
  line-height: 1.5;
  font-weight: 700;
  word-break: break-all;
}

.notes-copy {
  margin-top: 18rpx;
  color: var(--brand-muted);
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.cta-group {
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.consult-button,
.inquiry-button {
  width: 100%;
  min-height: 100rpx;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.inquiry-button {
  background: var(--brand-ink);
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(36, 29, 22, 0.16);
}

.cta-title {
  font-size: 27rpx;
}

.cta-copy {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  font-weight: 500;
}

.consult-button {
  border: 2rpx solid var(--brand-line);
  background: var(--brand-surface);
  color: var(--brand-green);
}

.consult-contact-button {
  margin: 0;
  padding: 0;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  align-self: stretch;
  line-height: normal;
}

.consult-contact-button::after {
  border: none;
}

.back-button {
  margin: 6rpx auto 0;
  width: 260rpx;
  height: 76rpx;
  border-radius: 8rpx;
  background: var(--brand-ink);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
}

.state-shell {
  min-height: 70vh;
  padding-top: 48rpx;
  text-align: center;
}

.state-shell-error {
  padding-top: 24rpx;
}
