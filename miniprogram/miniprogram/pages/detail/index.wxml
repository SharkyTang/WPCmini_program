<view class="page">
  <view wx:if="{{loading}}" class="detail-skeleton" aria-label="正在读取案例">
    <view class="skeleton-hero"></view>
    <view class="skeleton-line skeleton-line-title"></view>
    <view class="skeleton-card">
      <view class="skeleton-line"></view>
      <view class="skeleton-line skeleton-line-short"></view>
      <view class="skeleton-line"></view>
    </view>
  </view>
  <view wx:elif="{{errorMessage}}" class="state-shell state-shell-error">
    <mp-msg
      ext-class="brand-msg"
      type="warn"
      title="案例暂不可用"
      desc="{{errorMessage}}"
    />
    <view class="error-actions">
      <view wx:if="{{errorCanRetry}}" class="retry-button" bindtap="retryLoadCase">重新加载</view>
      <view class="back-button" bindtap="goBack">返回案例库</view>
    </view>
  </view>
  <view wx:elif="{{caseItem}}" class="detail">
    <view wx:if="{{galleryItems.length}}" class="hero-image-wrap">
      <swiper
        class="hero-gallery"
        current="{{currentImageIndex}}"
        circular="{{galleryItems.length > 1}}"
        bindchange="onGalleryChange"
      >
        <swiper-item wx:for="{{galleryItems}}" wx:key="index">
          <image
            wx:if="{{item.renderUrl}}"
            class="hero-image"
            mode="aspectFill"
            src="{{item.renderUrl}}"
            data-index="{{index}}"
            binderror="onHeroImageError"
            bindtap="previewImage"
          ></image>
          <view wx:else class="hero-image hero-image-empty">图片暂不可用</view>
        </swiper-item>
      </swiper>
      <view
        class="hero-favorite {{isFavorited ? 'hero-favorite-active' : ''}}"
        catchtap="toggleFavorite"
      >
        <image
          wx:if="{{!isFavorited}}"
          class="hero-favorite-icon"
          src="/assets/profile/icon-favorite.png"
          mode="aspectFit"
        />
        <view wx:else class="hero-favorite-heart">♥</view>
        <view class="hero-favorite-label">
          {{favoriteLoading ? '处理中' : (isFavorited ? '已收藏' : '收藏')}}
        </view>
      </view>
      <view class="image-count">{{currentImageIndex + 1}} / {{galleryItems.length}}</view>
    </view>
    <view wx:else class="hero-placeholder">
      <view class="placeholder-title">暂无案例图片</view>
      <view class="placeholder-copy">可先查看案例信息，稍后再试</view>
    </view>

    <scroll-view
      wx:if="{{galleryItems.length > 1}}"
      class="gallery-thumbnails"
      scroll-x
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="gallery-thumbnails-track">
        <view
          wx:for="{{galleryItems}}"
          wx:key="index"
          class="gallery-thumbnail {{currentImageIndex === index ? 'gallery-thumbnail-active' : ''}}"
          data-index="{{index}}"
          bindtap="selectGalleryImage"
        >
          <image wx:if="{{item.thumbnailUrl}}" class="gallery-thumbnail-image" src="{{item.thumbnailUrl}}" mode="aspectFill" lazy-load></image>
          <view wx:else class="gallery-thumbnail-image gallery-thumbnail-empty"></view>
        </view>
      </view>
    </scroll-view>

    <view class="info-card">
      <view class="info-card-head">
        <view class="section-title">案例信息</view>
        <view class="section-title info-case-title">{{caseItem.title}}</view>
      </view>
      <view wx:for="{{infoRows}}" wx:key="label" class="info-row">
        <view class="info-label">{{item.label}}</view>
        <view class="info-value">{{item.value}}</view>
      </view>
    </view>

    <view wx:if="{{caseItem.notes}}" class="notes-card">
      <view class="section-kicker">DESIGN NOTES</view>
      <view class="section-title">{{detailHeading}}</view>
      <view class="notes-copy">{{caseItem.notes}}</view>
    </view>

    <view class="cta-group">
      <view class="inquiry-button" bindtap="openInquiryForm">
        <view class="cta-title">提交定制需求</view>
        <view class="cta-copy">告诉我们包装方向和使用场景</view>
      </view>

      <block wx:if="{{customerServiceMessageImage}}">
        <button
          class="consult-button consult-contact-button"
          open-type="contact"
          session-from="{{customerServiceSessionFrom}}"
          show-message-card="{{customerServiceMessageCardEnabled}}"
          send-message-title="{{customerServiceMessageTitle}}"
          send-message-path="{{customerServiceMessagePath}}"
          send-message-img="{{customerServiceMessageImage}}"
          bindcontact="handleContact"
        >
          咨询同款包装方案
        </button>
      </block>
      <block wx:else>
        <button
          class="consult-button consult-contact-button"
          open-type="contact"
          session-from="{{customerServiceSessionFrom}}"
          show-message-card="{{customerServiceMessageCardEnabled}}"
          send-message-title="{{customerServiceMessageTitle}}"
          send-message-path="{{customerServiceMessagePath}}"
          bindcontact="handleContact"
        >
          咨询同款包装方案
        </button>
      </block>
    </view>
  </view>

</view>
