<view class="page">
  <view wx:if="{{loading}}" class="state-box">正在读取案例...</view>
  <view wx:elif="{{errorMessage}}" class="state-box state-error">
    {{errorMessage}}
    <view class="back-button" bindtap="goBack">返回首页</view>
  </view>
  <view wx:else class="detail">
    <view class="hero-copy">
      <view class="case-title">{{caseItem.title}}</view>
      <view class="case-subtitle">产品卡片点击后进入详情确认信息</view>
    </view>

    <view wx:if="{{caseItem.coverImageUrl}}" class="hero-image-wrap" bindtap="previewImage">
      <image
        class="hero-image"
        mode="aspectFill"
        src="{{caseItem.coverImageUrl}}"
      ></image>
      <view
        class="hero-favorite {{isFavorited ? 'hero-favorite-active' : ''}}"
        catchtap="toggleFavorite"
      >
        <image
          wx:if="{{!isFavorited}}"
          class="hero-favorite-icon"
          src="/assets/profile/icon-favorite.png"
          mode="aspectFit"
        />
        <view wx:else class="hero-favorite-heart">♥</view>
        <view class="hero-favorite-label">
          {{favoriteLoading ? '处理中' : (isFavorited ? '已收藏' : '收藏')}}
        </view>
      </view>
    </view>
    <view wx:else class="hero-placeholder">暂无图片</view>

    <view class="title-block">
      <view class="detail-heading">{{detailHeading}}</view>
      <view class="detail-subtitle">{{detailSubtitle}}</view>
    </view>

    <view class="info-card">
      <view wx:for="{{infoRows}}" wx:key="label" class="info-row">
        <view class="info-label">{{item.label}}</view>
        <view class="info-value">{{item.value}}</view>
      </view>
      <view wx:if="{{caseItem.notes}}" class="info-row info-row-notes">
        <view class="info-label">备注</view>
        <view class="info-value">{{caseItem.notes}}</view>
      </view>
    </view>

    <view class="inquiry-button" bindtap="openInquiryForm">提交定制需求</view>

    <button
      class="consult-button consult-contact-button"
      open-type="contact"
      session-from="{{customerServiceSessionFrom}}"
      bindcontact="handleContact"
    >
      咨询同款包装方案
    </button>
  </view>

  <view wx:if="{{imagePreviewVisible}}" class="image-preview-layer" bindtap="closeImagePreview">
    <view class="image-preview-close" catchtap="closeImagePreview">×</view>
    <movable-area class="image-preview-area" catchtap="noop">
      <movable-view
        class="image-preview-movable"
        direction="all"
        scale="{{true}}"
        scale-min="1"
        scale-max="4"
        scale-area="{{true}}"
      >
        <image
          class="image-preview-image"
          mode="aspectFit"
          src="{{caseItem.coverImageUrl}}"
        ></image>
      </movable-view>
    </movable-area>
    <view class="image-preview-download" catchtap="downloadImage">
      <image
        class="image-preview-download-icon"
        src="/assets/detail/icon-download.png"
        mode="aspectFit"
      ></image>
      <view>下载图片</view>
    </view>
  </view>
</view>
