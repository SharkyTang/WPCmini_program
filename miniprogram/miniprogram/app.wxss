/**app.wxss**/
page {
  --brand-bg: #f5efe4;
  --brand-surface: #fffdf8;
  --brand-surface-strong: #fff8ef;
  --brand-ink: #241d16;
  --brand-muted: #766b60;
  --brand-line: #e3d2bb;
  --brand-gold: #b77a2d;
  --brand-gold-soft: #f6ead8;
  --brand-green: #285f42;
  --brand-green-soft: #e7f1e8;
  --brand-red: #a33b31;
  --brand-red-soft: #fff2ef;
  --brand-shadow: 0 12rpx 30rpx rgba(72, 49, 25, 0.08);
  background: var(--brand-bg);
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}

.dialog-button-primary {
  color: #285f42 !important;
  font-weight: 700;
}

.dialog-button-danger {
  color: #a33b31 !important;
  font-weight: 700;
}


page {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}
