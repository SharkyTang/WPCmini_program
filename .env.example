# 复制为 .env.local 后填写。不要提交 .env.local 或任何真实凭证。

# 服务端脚本与 CloudBase Node SDK
CLOUDBASE_ENV_ID=your-staging-env-id
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# caseAdmin / imageProcessor 云函数环境变量
CASE_ADMIN_UIDS=cloudbase-user-uid-1,cloudbase-user-uid-2
ADMIN_OPENIDS=wechat-openid-1,wechat-openid-2
ADMIN_WEB_WRITE_ENABLED=false

# admin-web 构建时公开配置（Publishable Key 可以出现在浏览器端）
VITE_CLOUDBASE_ENV_ID=your-staging-env-id
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISHABLE_KEY=your-publishable-key
